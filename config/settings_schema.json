[
  {
    "name": "theme_info",
    "theme_name": "Aurelia",
    "theme_version": "1.0.0",
    "theme_author": "Profit Pages",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://help.shopify.com/manual/online-store/themes"
  },
  {
    "name": "Getting started",
    "settings": [
      {
        "type": "paragraph",
        "content": "Welcome to Aurelia. These steps make your store match the demo:"
      },
      {
        "type": "header",
        "content": "1. Menus"
      },
      {
        "type": "paragraph",
        "content": "Online Store › Navigation: build a Main menu (e.g. Shop, Collections, New arrivals, Best sellers) and footer menus (Shop, About, Help, Customer). Nested links become dropdowns or a mega menu."
      },
      {
        "type": "header",
        "content": "2. Jewellery details"
      },
      {
        "type": "paragraph",
        "content": "Settings › Custom data › Products: add the optional metafields custom.material, custom.metal_type, custom.metal_color, custom.stone_type, custom.stone_size, custom.carat, custom.weight, custom.dimensions, custom.finish, custom.plating, custom.hypoallergenic, custom.water_resistance, custom.care, custom.shipping_note and custom.product_story. Empty fields are hidden automatically."
      },
      {
        "type": "header",
        "content": "3. Filters"
      },
      {
        "type": "paragraph",
        "content": "Install Shopify Search & Discovery to add collection filters (category, metal, stone, price, availability) and complementary products for 'Style it with'."
      },
      {
        "type": "header",
        "content": "4. Reviews"
      },
      {
        "type": "paragraph",
        "content": "Install a reviews app (Judge.me, Okendo, Shopify Product Reviews…). Ratings appear on cards automatically; add the app block to the Reviews section on product pages."
      }
    ]
  },
  {
