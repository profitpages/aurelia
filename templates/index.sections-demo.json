    "faq_faq": {
      "type": "faq",
      "settings": {},
      "blocks": {
        "question_1": {
          "type": "question",
          "settings": {
            "question": "When will my order ship?",
            "answer": "<p>Orders are prepared within one business day and usually arrive in 2–5 days.</p>"
          }
        },
        "question_2": {
          "type": "question",
          "settings": {
            "question": "What is your returns approach?",
            "answer": "<p>Unworn pieces can be returned within 30 days for a full refund. Engraved pieces are final sale.</p>"
          }
        },
        "question_3": {
          "type": "question",
          "settings": {
            "question": "How do I care for my jewellery?",
            "answer": "<p>Store pieces separately in their pouch, keep them away from perfume and water, and polish gently with a soft cloth.</p>"
          }
        },
        "question_4": {
          "type": "question",
          "settings": {
            "question": "Is your jewellery suitable for sensitive skin?",
            "answer": "<p>Most pieces are nickel-free and hypoallergenic. Each product page lists its materials.</p>"
          }
        },
        "question_5": {
          "type": "question",
          "settings": {
            "question": "Where are your pieces made?",
            "answer": "<p>Add details about your materials, sourcing and certifications here.</p>"
          }
        },
        "question_6": {
          "type": "question",
          "settings": {
            "question": "How can I get order support?",
            "answer": "<p>Write to us any time — we reply within one business day.</p>"
          }
        }
      },
      "block_order": [
        "question_1",
        "question_2",
        "question_3",
        "question_4",
        "question_5",
        "question_6"
      ]
    },
