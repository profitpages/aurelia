{%- comment -%}
  Accordion row whose content can come from a product metafield. Rows with no content are skipped.
  Usage: {% render 'detail-row', block: block, product: product, compact: false %}
{%- endcomment -%}
{%- liquid
  assign b = block.settings
  assign body = ''
  case b.source
    when 'description'
      assign body = product.description
    when 'care'
      assign body = product.metafields.custom.care | metafield_tag
      if body == blank
        assign body = product.metafields.custom.care_instructions | metafield_tag
      endif
    when 'materials'
      assign body = product.metafields.custom.material | metafield_tag
    when 'shipping'
      assign body = product.metafields.custom.shipping_note | metafield_tag
    when 'story'
      assign body = product.metafields.custom.product_story | metafield_tag
    when 'dimensions'
      assign body = product.metafields.custom.dimensions | metafield_tag
  endcase
  if body == blank
    assign body = b.content
  endif
-%}
{%- if body != blank or b.page != blank -%}
  <details class="acc{% if compact %} acc--compact{% endif %}" data-accordion{% if b.open %} open{% endif %} {{ block.shopify_attributes }}>
    <summary class="acc__q">{{ b.heading | escape }}<span class="acc__plus" aria-hidden="true"></span></summary>
    <div class="acc__a">
      <div class="acc__inner rte">
        {{ body }}
        {%- if b.page != blank -%}{{ b.page.content }}{%- endif -%}
      </div>
    </div>
  </details>
{%- endif -%}
