{%- comment -%}
  Optional decorative layer (glow, accent dot, soft arcs). Hidden unless Theme settings ›
  Motion & texture › "Show decorative accents" is on.
  Usage: {% render 'decor', preset: 'hero' %}  presets: hero, corner, band, dot
{%- endcomment -%}
{%- if settings.decor_enable -%}
  <div class="decor decor--{{ preset | default: 'corner' }}" aria-hidden="true">
    {%- case preset -%}
      {%- when 'hero' -%}
        <span class="glow"></span>
      {%- when 'band' -%}
        <span class="glow glow--band"></span>
      {%- when 'dot' -%}
        <span class="dot-accent"></span>
      {%- else -%}
        <span class="glow glow--corner"></span>
    {%- endcase -%}
  </div>
{%- endif -%}
