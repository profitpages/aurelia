{%- comment -%} Statement strip — one serif line with a quiet link, between hairlines (Canva collection intro). {%- endcomment -%}
{{ 'section-aurelia.css' | asset_url | stylesheet_tag }}
{%- assign s = section.settings -%}
<section class="statement color-{{ s.color_scheme }}">
  <div class="statement__inner page-width">
    {%- if s.text != blank -%}<p class="statement__text">{{ s.text | escape }}</p>{%- endif -%}
    {%- if s.link_label != blank -%}<a class="statement__link" href="{{ s.link | default: routes.all_products_collection_url }}">{{ s.link_label | escape }}</a>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Statement strip",
  "class": "section-statement",
  "settings": [
    { "type": "text", "id": "text", "label": "Statement", "default": "Designed to be worn, layered, gifted, and remembered." },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Discover our craftsmanship →" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "presets": [{ "name": "Statement strip" }]
}
{% endschema %}
