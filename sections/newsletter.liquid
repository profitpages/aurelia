{%- comment -%}
  Newsletter — Shopify customer form (subscribers get the 'newsletter' tag and marketing consent).
  Layouts: center (Canva band: eyebrow, heading, copy, joined field) | split (copy left, field right)
  On dark schemes the button uses the champagne accent; on light schemes it uses the solid scheme button.
{%- endcomment -%}
{{ 'section-aurelia.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  assign nl_id = 'Newsletter-' | append: section.id
  assign scheme = settings.color_schemes[s.color_scheme]
  assign btn_class = 'btn btn--solid'
  if scheme.settings.background.lightness < 45
    assign btn_class = 'btn btn--accent'
  endif
  assign nl_placeholder = s.placeholder
  if nl_placeholder == blank
    assign nl_placeholder = 'newsletter.email_label' | t
  endif
-%}
<section class="nl-band nl-band--{{ s.layout }} color-{{ s.color_scheme }}">
  <div class="page-width">
    <div class="nl-band__inner">
      <div class="nl-band__copy">
        {%- if s.kicker != blank -%}<p class="kicker">{{ s.kicker | escape }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="h2">{{ s.heading | escape }}</h2>{%- endif -%}
        {%- if s.text != blank -%}<div class="rte nl-band__text">{{ s.text }}</div>{%- endif -%}
      </div>
      {%- form 'customer', id: nl_id, class: 'nl-form nl-band__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        {%- if form.posted_successfully? -%}
          <p class="form-msg form-msg--ok" role="status" tabindex="-1" autofocus>{% render 'icon', name: 'check', size: 16 %} {{ 'newsletter.success' | t }}</p>
        {%- else -%}
          <div class="nl-form__field">
            <label class="visually-hidden" for="{{ nl_id }}-email">{{ 'newsletter.email_label' | t }}</label>
            <input class="input" id="{{ nl_id }}-email" type="email" name="contact[email]" autocomplete="email" required placeholder="{{ nl_placeholder | escape }}"{% if form.errors %} aria-invalid="true" aria-describedby="{{ nl_id }}-error"{% endif %}>
            <button class="{{ btn_class }}" type="submit">{{ s.button_label | escape }}</button>
          </div>
          {%- if form.errors -%}<p class="form-msg form-msg--error" id="{{ nl_id }}-error">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>{%- endif -%}
          {%- if s.consent != blank -%}<p class="nl-form__consent">{{ s.consent | escape }}</p>{%- endif -%}
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.newsletter.name",
  "class": "section-newsletter",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.newsletter.settings.layout.label",
      "options": [
        {
          "value": "center",
          "label": "t:sections.newsletter.settings.layout.options__1.label"
        },
        {
          "value": "split",
          "label": "t:sections.newsletter.settings.layout.options__2.label"
        }
      ],
      "default": "center"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "t:sections.newsletter.settings.kicker.label",
      "default": "The Aurelia letter"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.newsletter.settings.heading.label",
      "default": "A little luxury, in your inbox"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.newsletter.settings.text.label",
      "default": "<p>Be the first to discover new collections, exclusive offers, and styling inspiration.</p>"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "t:sections.newsletter.settings.placeholder.label",
      "default": "Enter your email address"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.newsletter.settings.button_label.label",
      "default": "Join us"
    },
    {
      "type": "text",
      "id": "consent",
      "label": "t:sections.newsletter.settings.consent.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.newsletter.settings.color_scheme.label",
      "default": "scheme-5"
    }
  ],
  "presets": [
    {
      "name": "t:sections.newsletter.presets.presets__1.name"
    },
    {
      "name": "t:sections.newsletter.presets.presets__2.name",
      "settings": {
        "color_scheme": "scheme-8"
      }
    }
  ]
}
{% endschema %}
