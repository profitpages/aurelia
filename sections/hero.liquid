{%- comment -%}
  Aurelia hero / image banner — full-bleed photograph with a tonal overlay and editorial copy.
  The same section powers the home hero ("Jewelry that tells your story"), the story banner and the
  centred "Signature collection" banner via presets. Separate desktop and mobile images.
{%- endcomment -%}
{{ 'section-hero.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  assign htag = 'h2'
  if section.index == 1 and s.title_as_h1
    assign htag = 'h1'
  endif
  assign eager = false
  if section.index <= 2
    assign eager = true
  endif
  assign title_class = 'hero__title display'
  if s.title_size == 'md'
    assign title_class = 'hero__title h1'
  endif
-%}
<section class="hero hero--{{ s.height }} hero--x-{{ s.content_x }} hero--y-{{ s.content_y }} hero--text-{{ s.text_tone }} color-{{ s.color_scheme }}" style="--img-pos: {{ s.image_position }}; --hero-overlay: {{ s.overlay | divided_by: 100.0 }};">
  <div class="hero__media{% if s.mobile_image != blank %} has-mobile{% endif %}" aria-hidden="true">
    {%- if s.image != blank -%}
      {%- render 'responsive-image', image: s.image, max: 2800, sizes: '100vw', class: 'hero__img hero__img--desk', eager: eager, alt: '' -%}
      {%- if s.mobile_image != blank -%}{%- render 'responsive-image', image: s.mobile_image, max: 1200, sizes: '100vw', class: 'hero__img hero__img--mob', eager: eager, alt: '' -%}{%- endif -%}
    {%- else -%}
      <div class="hero__art">{%- render 'cosmetic-art', name: s.placeholder_art, tone: 'gold' -%}</div>
    {%- endif -%}
  </div>
  <div class="hero__shade" aria-hidden="true"></div>

  <div class="hero__content page-width">
    <div class="hero__copy" data-reveal>
      {%- if s.kicker != blank -%}<p class="kicker hero__kicker">{{ s.kicker | escape }}</p>{%- endif -%}
      {%- if s.heading != blank -%}<{{ htag }} class="{{ title_class }}">{{ s.heading | escape }}</{{ htag }}>{%- endif -%}
      {%- if s.text != blank -%}<div class="hero__text rte">{{ s.text }}</div>{%- endif -%}
      {%- if s.button_label != blank or s.button2_label != blank -%}
        <div class="btn-row hero__buttons">
          {%- render 'button', label: s.button_label, url: s.button_link, style: s.button_style -%}
          {%- render 'button', label: s.button2_label, url: s.button2_link, style: s.button2_style -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

