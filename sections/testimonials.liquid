{%- comment -%}
  Testimonials — merchant-entered customer words (never invented). For product reviews use the Reviews section.
  Layouts: cards (hairline-joined cards, Canva "Loved by thousands") | single (centred quote band)
{%- endcomment -%}
{{ 'section-aurelia.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  assign first = section.blocks.first
-%}
<section class="section testi testi--{{ s.layout }} color-{{ s.color_scheme }}">
  <div class="page-width{% if s.layout == 'cards' %} testi__wrap{% endif %}">
    {%- if s.layout == 'single' -%}
      <figure class="testi__single" data-reveal>
        {%- if s.kicker != blank -%}<p class="kicker">{{ s.kicker | escape }}</p>{%- endif -%}
        {%- if first -%}
          {%- if first.settings.stars > 0 -%}<span class="quote__stars" aria-label="{{ 'products.rating' | t: rating: first.settings.stars, max: 5 }}">{%- for i in (1..first.settings.stars) -%}★{%- endfor -%}</span>{%- endif -%}
          <blockquote class="testi__quote" {{ first.shopify_attributes }}>“{{ first.settings.quote | escape }}”</blockquote>
          <figcaption class="quote__by">{{ first.settings.author | escape }}{%- if first.settings.detail != blank -%}<span>{{ first.settings.detail | escape }}</span>{%- endif -%}</figcaption>
        {%- endif -%}
      </figure>
    {%- else -%}
      {%- render 'section-heading', kicker: s.kicker, title: s.heading, text: s.text, align: 'center' -%}
      <ul class="quotes" role="list" style="--cols: {{ section.blocks.size | at_least: 1 | at_most: 3 }};">
        {%- for block in section.blocks -%}
          {%- assign b = block.settings -%}
          <li class="quote" data-reveal {{ block.shopify_attributes }}>
            <figure>
              {%- if b.stars > 0 -%}<span class="quote__stars" aria-label="{{ 'products.rating' | t: rating: b.stars, max: 5 }}">{%- for i in (1..b.stars) -%}★{%- endfor -%}</span>{%- endif -%}
              <blockquote class="quote__text">“{{ b.quote | escape }}”</blockquote>
              <figcaption class="quote__by">
                {%- if b.avatar != blank -%}{{ b.avatar | image_url: width: 96 | image_tag: loading: 'lazy', alt: '', width: 40, height: 40, class: 'quote__avatar' }}{%- endif -%}
                {{ b.author | escape }}{%- if b.detail != blank -%}<span>{{ b.detail | escape }}</span>{%- endif -%}
              </figcaption>
              {%- if b.product != blank -%}<a class="quote__product link-underline" href="{{ b.product.url }}">{{ b.product.title | escape }}</a>{%- endif -%}
            </figure>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "class": "section-testimonials",
  "max_blocks": 6,
  "settings": [
    {
      "type": "select", "id": "layout", "label": "Layout",
      "options": [{ "value": "cards", "label": "Cards" }, { "value": "single", "label": "Single quote" }],
      "default": "cards"
    },
    { "type": "text", "id": "kicker", "label": "Eyebrow", "default": "Our community" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Loved by thousands" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "paragraph", "content": "Only publish words your customers actually wrote. For product reviews, use a reviews app." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-3" }
  ],
  "blocks": [
    {
      "type": "testimonial", "name": "Testimonial",
      "settings": [
        { "type": "range", "id": "stars", "label": "Stars", "min": 0, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "Absolutely stunning. The quality is even better than I expected and it looks beautiful in person." },
        { "type": "text", "id": "author", "label": "Name", "default": "Customer name" },
        { "type": "text", "id": "detail", "label": "Detail", "default": "Verified buyer" },
        { "type": "image_picker", "id": "avatar", "label": "Photo" },
        { "type": "product", "id": "product", "label": "Product" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        { "type": "testimonial" },
        { "type": "testimonial", "settings": { "quote": "My necklace has become part of my everyday uniform. It is delicate, polished, and endlessly wearable." } },
        { "type": "testimonial", "settings": { "quote": "The presentation made it feel truly special. A beautiful gift that felt considered from start to finish." } }
      ]
    },
    { "name": "Quote band", "settings": { "layout": "single", "kicker": "", "color_scheme": "scheme-2" }, "blocks": [{ "type": "testimonial" }] }
  ]
}
{% endschema %}
