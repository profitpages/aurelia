{%- comment -%} Icon columns — centred gold line icons with a serif title and a short line (Canva product page "Everyday ease · Responsible finish · Gift ready"). {%- endcomment -%}
{{ 'section-aurelia.css' | asset_url | stylesheet_tag }}
{%- assign s = section.settings -%}
<section class="icols color-{{ s.color_scheme }}{% if s.bordered %} icols--bordered{% endif %}">
  <div class="page-width">
    {%- render 'section-heading', kicker: s.kicker, title: s.heading, align: 'center' -%}
    <ul class="icols__list" role="list" style="--cols: {{ section.blocks.size | at_least: 1 | at_most: 4 }};">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <li class="icols__item" data-reveal {{ block.shopify_attributes }}>
          {%- if b.image != blank -%}
            <span class="icols__icon">{{ b.image | image_url: width: 120 | image_tag: loading: 'lazy', alt: '', width: 32, height: 32 }}</span>
          {%- elsif b.icon != 'none' -%}
            <span class="icols__icon">{%- render 'icon', name: b.icon, size: 24 -%}</span>
          {%- endif -%}
          {%- if b.title != blank -%}<h3 class="icols__title">{{ b.title | escape }}</h3>{%- endif -%}
          {%- if b.text != blank -%}<p class="icols__text">{{ b.text | escape }}</p>{%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.icon-columns.name",
  "class": "section-icon-columns",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "t:sections.icon-columns.settings.kicker.label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.icon-columns.settings.heading.label"
    },
    {
      "type": "checkbox",
      "id": "bordered",
      "label": "t:sections.icon-columns.settings.bordered.label",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.icon-columns.settings.color_scheme.label",
      "default": "scheme-2"
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "t:sections.icon-columns.blocks.column.name",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "t:sections.icon-columns.blocks.column.settings.icon.label",
          "options": [
            {
              "value": "sparkle",
              "label": "t:sections.icon-columns.blocks.column.settings.icon.options__1.label"
            },
            {
              "value": "leaf",
              "label": "t:sections.icon-columns.blocks.column.settings.icon.options__2.label"
            },
            {
              "value": "gift",
              "label": "t:sections.icon-columns.blocks.column.settings.icon.options__3.label"
            },
            {
              "value": "gem",
              "label": "t:sections.icon-columns.blocks.column.settings.icon.options__4.label"
            },
            {
              "value": "ring",
              "label": "t:sections.icon-columns.blocks.column.settings.icon.options__5.label"
            },
            {
              "value": "award",
              "label": "t:sections.icon-columns.blocks.column.settings.icon.options__6.label"
            },
            {
              "value": "pen",
              "label": "t:sections.icon-columns.blocks.column.settings.icon.options__7.label"
            },
            {
              "value": "shield-check",
              "label": "t:sections.icon-columns.blocks.column.settings.icon.options__8.label"
            },
            {
              "value": "truck",
              "label": "t:sections.icon-columns.blocks.column.settings.icon.options__9.label"
            },
            {
              "value": "return",
              "label": "t:sections.icon-columns.blocks.column.settings.icon.options__10.label"
            },
            {
              "value": "package",
              "label": "t:sections.icon-columns.blocks.column.settings.icon.options__11.label"
            },
            {
              "value": "none",
              "label": "t:sections.icon-columns.blocks.column.settings.icon.options__12.label"
            }
          ],
          "default": "sparkle"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.icon-columns.blocks.column.settings.image.label"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.icon-columns.blocks.column.settings.title.label",
          "default": "Everyday ease"
        },
        {
          "type": "text",
          "id": "text",
          "label": "t:sections.icon-columns.blocks.column.settings.text.label",
          "default": "A comfortable silhouette designed for repeat wear."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.icon-columns.presets.presets__1.name",
      "blocks": [
        {
          "type": "column",
          "settings": {
            "icon": "sparkle",
            "title": "Everyday ease",
            "text": "A comfortable silhouette designed for repeat wear."
          }
        },
        {
          "type": "column",
          "settings": {
            "icon": "leaf",
            "title": "Responsible finish",
            "text": "Made with considered materials and lasting detail."
          }
        },
        {
          "type": "column",
          "settings": {
            "icon": "gift",
            "title": "Gift ready",
            "text": "Presented in our signature Aurelia packaging."
          }
        }
      ]
    }
  ]
}
{% endschema %}
