{%- comment -%} Boutiques — store cards with a photo, city, address, opening hours, phone and a directions link. {%- endcomment -%}
{{ 'section-aurelia-extras.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  assign arts = 'gift,stack,necklace' | split: ','
-%}
<section class="section color-{{ s.color_scheme }}">
  <div class="page-width">
    {%- render 'section-heading', kicker: s.kicker, title: s.heading, text: s.text, align: 'center' -%}
    <ul class="stores" role="list" style="--cols: {{ section.blocks.size | at_least: 1 | at_most: 3 }};">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        {%- assign i = forloop.index0 | modulo: 3 -%}
        <li class="store" data-reveal {{ block.shopify_attributes }}>
          <div class="store__media">{%- render 'responsive-image', image: b.image, max: 1000, sizes: '(min-width: 990px) 31vw, 90vw', class: 'store__img', art: arts[i], alt: '' -%}</div>
          <div class="store__body">
            <h3 class="store__city">{{ b.city | escape }}</h3>
            {%- if b.address != blank -%}<p class="store__address">{{ b.address | escape | newline_to_br }}</p>{%- endif -%}
            {%- if b.hours != blank -%}
              <div class="store__hours">
                <p class="store__label">{%- render 'icon', name: 'clock', size: 16 -%}{{ 'sections.opening_hours' | t }}</p>
                <p>{{ b.hours | escape | newline_to_br }}</p>
              </div>
            {%- endif -%}
            {%- if b.phone != blank -%}<a class="store__phone" href="tel:{{ b.phone | remove: ' ' }}">{{ b.phone | escape }}</a>{%- endif -%}
            {%- if b.map_link != blank -%}<a class="link-underline store__go" href="{{ b.map_link }}" target="_blank" rel="noopener">{{ 'sections.get_directions' | t }}</a>{%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Boutiques",
  "class": "section-boutiques",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "kicker", "label": "Eyebrow", "default": "Visit us" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our boutiques" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Try pieces on, book a fitting, or have your jewellery cleaned while you wait.</p>" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "blocks": [
    {
      "type": "store", "name": "Boutique",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "city", "label": "City", "default": "London" },
        { "type": "textarea", "id": "address", "label": "Address", "default": "12 Example Street\nLondon W1" },
        { "type": "textarea", "id": "hours", "label": "Opening hours", "default": "Mon–Sat 10am–7pm\nSun 11am–5pm" },
        { "type": "text", "id": "phone", "label": "Phone" },
        { "type": "url", "id": "map_link", "label": "Map link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Boutiques",
      "blocks": [
        { "type": "store" },
        { "type": "store", "settings": { "city": "Paris", "address": "8 Rue Exemple\n75003 Paris" } },
        { "type": "store", "settings": { "city": "New York", "address": "100 Example Avenue\nNew York, NY" } }
      ]
    }
  ]
}
{% endschema %}
