{%- comment -%} Shop by category — collection tiles (Canva: 3 × 2 grid, 5:6 photos, serif names, "Explore collection →"). {%- endcomment -%}
{{ 'section-aurelia.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  assign arts = 'ring,necklace,earrings,bracelet,chain,gift' | split: ','
  case s.ratio
    when 'square'
      assign r = 1
    when 'portrait'
      assign r = 0.8
    when 'landscape'
      assign r = 1.25
    else
      assign r = 0.83
  endcase
-%}
<section class="section color-{{ s.color_scheme }}">
  <div class="page-width">
    {%- render 'section-heading', kicker: s.kicker, title: s.heading, text: s.text, align: s.heading_align, link_label: s.link_label, link: s.link -%}
    <ul class="ctiles" role="list" style="--cols: {{ s.columns }}; --cols-m: {{ s.columns_mobile }};">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        {%- assign i = forloop.index0 | modulo: 6 -%}
        <li {{ block.shopify_attributes }}>
          {%- render 'collection-tile', collection: b.collection, image: b.image, title: b.title, url: b.link, link_label: s.tile_link_label, art: arts[i], show_count: s.show_count, ratio: r, sizes: '(min-width: 990px) 31vw, 47vw' -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.collection-grid.name",
  "class": "section-collection-grid",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "t:sections.collection-grid.settings.kicker.label",
      "default": "Discover Aurelia"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.collection-grid.settings.heading.label",
      "default": "Shop by category"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.collection-grid.settings.text.label",
      "default": "<p>Find the piece that completes your look.</p>"
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "t:sections.collection-grid.settings.heading_align.label",
      "options": [
        {
          "value": "center",
          "label": "t:sections.collection-grid.settings.heading_align.options__1.label"
        },
        {
          "value": "left",
          "label": "t:sections.collection-grid.settings.heading_align.options__2.label"
        }
      ],
      "default": "center"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "t:sections.collection-grid.settings.link_label.label"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:sections.collection-grid.settings.link.label"
    },
    {
      "type": "text",
      "id": "tile_link_label",
      "label": "t:sections.collection-grid.settings.tile_link_label.label",
      "default": "Explore collection →"
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "t:sections.collection-grid.settings.ratio.label",
      "options": [
        {
          "value": "jewel",
          "label": "t:sections.collection-grid.settings.ratio.options__1.label"
        },
        {
          "value": "portrait",
          "label": "t:sections.collection-grid.settings.ratio.options__2.label"
        },
        {
          "value": "square",
          "label": "t:sections.collection-grid.settings.ratio.options__3.label"
        },
        {
          "value": "landscape",
          "label": "t:sections.collection-grid.settings.ratio.options__4.label"
        }
      ],
      "default": "jewel"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:sections.collection-grid.settings.columns.label",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "t:sections.collection-grid.settings.columns_mobile.label",
      "options": [
        {
          "value": "1",
          "label": "t:sections.collection-grid.settings.columns_mobile.options__1.label"
        },
        {
          "value": "2",
          "label": "t:sections.collection-grid.settings.columns_mobile.options__2.label"
        }
      ],
      "default": "2"
    },
    {
      "type": "checkbox",
      "id": "show_count",
      "label": "t:sections.collection-grid.settings.show_count.label",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.collection-grid.settings.color_scheme.label",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "t:sections.collection-grid.blocks.collection.name",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "t:sections.collection-grid.blocks.collection.settings.collection.label"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.collection-grid.blocks.collection.settings.image.label",
          "info": "t:sections.collection-grid.blocks.collection.settings.image.info"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.collection-grid.blocks.collection.settings.title.label",
          "info": "t:sections.collection-grid.blocks.collection.settings.title.info"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.collection-grid.blocks.collection.settings.link.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.collection-grid.presets.presets__1.name",
      "blocks": [
        {
          "type": "collection",
          "settings": {
            "title": "Rings"
          }
        },
        {
          "type": "collection",
          "settings": {
            "title": "Necklaces"
          }
        },
        {
          "type": "collection",
          "settings": {
            "title": "Earrings"
          }
        },
        {
          "type": "collection",
          "settings": {
            "title": "Bracelets"
          }
        },
        {
          "type": "collection",
          "settings": {
            "title": "Chains"
          }
        },
        {
          "type": "collection",
          "settings": {
            "title": "Gift sets"
          }
        }
      ]
    }
  ]
}
{% endschema %}
