{%- comment -%} Shop by category — collection tiles (Canva: 3 × 2 grid, 5:6 photos, serif names, "Explore collection →"). {%- endcomment -%}
{{ 'section-aurelia.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  assign arts = 'ring,necklace,earrings,bracelet,chain,gift' | split: ','
  case s.ratio
    when 'square'
      assign r = 1
    when 'portrait'
      assign r = 0.8
    when 'landscape'
      assign r = 1.25
    else
      assign r = 0.83
  endcase
-%}
<section class="section color-{{ s.color_scheme }}">
  <div class="page-width">
    {%- render 'section-heading', kicker: s.kicker, title: s.heading, text: s.text, align: s.heading_align, link_label: s.link_label, link: s.link -%}
    <ul class="ctiles" role="list" style="--cols: {{ s.columns }}; --cols-m: {{ s.columns_mobile }};">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        {%- assign i = forloop.index0 | modulo: 6 -%}
        <li {{ block.shopify_attributes }}>
          {%- render 'collection-tile', collection: b.collection, image: b.image, title: b.title, url: b.link, link_label: s.tile_link_label, art: arts[i], show_count: s.show_count, ratio: r, sizes: '(min-width: 990px) 31vw, 47vw' -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Collection grid",
  "class": "section-collection-grid",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "kicker", "label": "Eyebrow", "default": "Discover Aurelia" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by category" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Find the piece that completes your look.</p>" },
    {
      "type": "select", "id": "heading_align", "label": "Heading alignment",
      "options": [{ "value": "center", "label": "Center" }, { "value": "left", "label": "Left" }],
      "default": "center"
    },
    { "type": "text", "id": "link_label", "label": "Heading link label" },
    { "type": "url", "id": "link", "label": "Heading link" },
    { "type": "text", "id": "tile_link_label", "label": "Tile link label", "default": "Explore collection →" },
    {
      "type": "select", "id": "ratio", "label": "Tile shape",
      "options": [{ "value": "jewel", "label": "Portrait 5:6" }, { "value": "portrait", "label": "Portrait 4:5" }, { "value": "square", "label": "Square" }, { "value": "landscape", "label": "Landscape" }],
      "default": "jewel"
    },
    { "type": "range", "id": "columns", "label": "Tiles per row (desktop)", "min": 2, "max": 4, "step": 1, "default": 3 },
    { "type": "select", "id": "columns_mobile", "label": "Tiles per row (mobile)", "options": [{ "value": "1", "label": "1" }, { "value": "2", "label": "2" }], "default": "2" },
    { "type": "checkbox", "id": "show_count", "label": "Show product count", "default": false },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "blocks": [
    {
      "type": "collection", "name": "Collection",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Defaults to the collection image." },
        { "type": "text", "id": "title", "label": "Title", "info": "Defaults to the collection title." },
        { "type": "url", "id": "link", "label": "Custom link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection grid",
      "blocks": [
        { "type": "collection", "settings": { "title": "Rings" } },
        { "type": "collection", "settings": { "title": "Necklaces" } },
        { "type": "collection", "settings": { "title": "Earrings" } },
        { "type": "collection", "settings": { "title": "Bracelets" } },
        { "type": "collection", "settings": { "title": "Chains" } },
        { "type": "collection", "settings": { "title": "Gift sets" } }
      ]
    }
  ]
}
{% endschema %}
