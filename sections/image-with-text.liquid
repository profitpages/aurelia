{%- comment -%}
  Image with text — the Aurelia editorial split.
  Layouts: panel (full-bleed photo + tinted panel, home "The everyday collection"),
           inset (contained block on a dark/tinted scheme, collection "The art of layering"),
           split (photo + copy on the page background, collection "Crafted for your every day", product story).
  On product pages the text can come from the product metafield custom.product_story.
{%- endcomment -%}
{{ 'section-aurelia.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  assign body = s.text
  if s.use_product_story and product != blank
    assign story = product.metafields.custom.product_story | metafield_tag
    if story != blank
      assign body = story
    endif
  endif
  assign img = s.image
  if img == blank and s.use_product_image and product != blank
    assign img = product.media[1].preview_image | default: product.featured_media.preview_image
  endif
  case s.image_ratio
    when 'portrait'
      assign r = 'aspect-ratio: 4 / 5;'
    when 'landscape'
      assign r = 'aspect-ratio: 1 / .82;'
    when 'square'
      assign r = 'aspect-ratio: 1;'
    else
      assign r = ''
  endcase
-%}
<section class="iwt iwt--{{ s.layout }} iwt--img-{{ s.image_side }} color-{{ s.section_scheme }}{% if s.layout != 'panel' %} section{% endif %}{% if s.layout == 'split' and s.tight %} section--tight{% endif %}">
  <div class="iwt__wrap{% if s.layout != 'panel' %} page-width{% endif %}">
    <div class="iwt__grid{% if s.layout == 'inset' %} color-{{ s.color_scheme }}{% endif %}" style="--min-h: {{ s.min_height }}px;">
      <div class="iwt__media{% if r == blank %} iwt__media--fill{% endif %}" style="{{ r }}">
        {%- render 'responsive-image', image: img, max: 1800, sizes: '(min-width: 750px) 50vw, 100vw', class: 'iwt__img', art: s.placeholder_art -%}
      </div>
      <div class="iwt__copy{% if s.layout == 'panel' %} color-{{ s.color_scheme }}{% endif %}">
        <div class="iwt__inner" data-reveal>
          {%- if s.kicker != blank -%}<p class="kicker{% if s.kicker_plain %} iwt__kicker--plain{% endif %}">{{ s.kicker | escape }}</p>{%- endif -%}
          {%- if s.heading != blank -%}<h2 class="h2 iwt__title">{{ s.heading | escape }}</h2>{%- endif -%}
          {%- if body != blank -%}<div class="iwt__text rte">{{ body }}</div>{%- endif -%}
          {%- render 'button', label: s.button_label, url: s.button_link, style: s.button_style -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.image-with-text.name",
  "class": "section-image-with-text",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.image-with-text.settings.layout.label",
      "options": [
        {
          "value": "panel",
          "label": "t:sections.image-with-text.settings.layout.options__1.label"
        },
        {
          "value": "inset",
          "label": "t:sections.image-with-text.settings.layout.options__2.label"
        },
        {
          "value": "split",
          "label": "t:sections.image-with-text.settings.layout.options__3.label"
        }
      ],
      "default": "panel"
    },
    {
      "type": "select",
      "id": "image_side",
      "label": "t:sections.image-with-text.settings.image_side.label",
      "options": [
        {
          "value": "left",
          "label": "t:sections.image-with-text.settings.image_side.options__1.label"
        },
        {
          "value": "right",
          "label": "t:sections.image-with-text.settings.image_side.options__2.label"
        }
      ],
      "default": "left"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.image-with-text.settings.image.label"
    },
    {
      "type": "checkbox",
      "id": "use_product_image",
      "label": "t:sections.image-with-text.settings.use_product_image.label",
      "default": false
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:sections.image-with-text.settings.image_ratio.label",
      "options": [
        {
          "value": "fill",
          "label": "t:sections.image-with-text.settings.image_ratio.options__1.label"
        },
        {
          "value": "portrait",
          "label": "t:sections.image-with-text.settings.image_ratio.options__2.label"
        },
        {
          "value": "landscape",
          "label": "t:sections.image-with-text.settings.image_ratio.options__3.label"
        },
        {
          "value": "square",
          "label": "t:sections.image-with-text.settings.image_ratio.options__4.label"
        }
      ],
      "default": "fill"
    },
    {
      "type": "select",
      "id": "placeholder_art",
      "label": "t:sections.image-with-text.settings.placeholder_art.label",
      "options": [
        {
          "value": "necklace",
          "label": "t:sections.image-with-text.settings.placeholder_art.options__1.label"
        },
        {
          "value": "ring",
          "label": "t:sections.image-with-text.settings.placeholder_art.options__2.label"
        },
        {
          "value": "stack",
          "label": "t:sections.image-with-text.settings.placeholder_art.options__3.label"
        },
        {
          "value": "bust",
          "label": "t:sections.image-with-text.settings.placeholder_art.options__4.label"
        },
        {
          "value": "gift",
          "label": "t:sections.image-with-text.settings.placeholder_art.options__5.label"
        }
      ],
      "default": "necklace"
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "t:sections.image-with-text.settings.min_height.label",
      "min": 300,
      "max": 720,
      "step": 20,
      "unit": "px",
      "default": 460
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "t:sections.image-with-text.settings.kicker.label",
      "default": "The edit"
    },
    {
      "type": "checkbox",
      "id": "kicker_plain",
      "label": "t:sections.image-with-text.settings.kicker_plain.label",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.image-with-text.settings.heading.label",
      "default": "The everyday collection"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.image-with-text.settings.text.label",
      "default": "<p>Designed to elevate the moments that matter.</p>"
    },
    {
      "type": "checkbox",
      "id": "use_product_story",
      "label": "t:sections.image-with-text.settings.use_product_story.label",
      "info": "t:sections.image-with-text.settings.use_product_story.info",
      "default": false
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.image-with-text.settings.button_label.label",
      "default": "Shop everyday jewellery"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.image-with-text.settings.button_link.label"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "t:sections.image-with-text.settings.button_style.label",
      "options": [
        {
          "value": "link",
          "label": "t:sections.image-with-text.settings.button_style.options__1.label"
        },
        {
          "value": "solid",
          "label": "t:sections.image-with-text.settings.button_style.options__2.label"
        },
        {
          "value": "outline",
          "label": "t:sections.image-with-text.settings.button_style.options__3.label"
        }
      ],
      "default": "link"
    },
    {
      "type": "checkbox",
      "id": "tight",
      "label": "t:sections.image-with-text.settings.tight.label",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.image-with-text.settings.color_scheme.label",
      "default": "scheme-4"
    },
    {
      "type": "color_scheme",
      "id": "section_scheme",
      "label": "t:sections.image-with-text.settings.section_scheme.label",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "t:sections.image-with-text.presets.presets__1.name"
    },
    {
      "name": "t:sections.image-with-text.presets.presets__2.name",
      "settings": {
        "layout": "inset",
        "color_scheme": "scheme-7",
        "kicker": "The Aurelia edit",
        "kicker_plain": false,
        "heading": "The art of layering",
        "text": "<p>Build a collection that feels entirely your own, from delicate essentials to unmistakable statement pieces.</p>",
        "button_label": "Explore styling notes",
        "placeholder_art": "stack"
      }
    },
    {
      "name": "t:sections.image-with-text.presets.presets__3.name",
      "settings": {
        "layout": "split",
        "image_ratio": "landscape",
        "kicker": "Our approach",
        "heading": "Crafted for your every day",
        "text": "<p>Every Aurelia piece is thoughtfully designed to feel effortless, distinctive, and enduring.</p>",
        "button_label": "Discover our story",
        "placeholder_art": "ring"
      }
    }
  ]
}
{% endschema %}
