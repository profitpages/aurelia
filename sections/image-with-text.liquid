{%- comment -%}
  Image with text — the Aurelia editorial split.
  Layouts: panel (full-bleed photo + tinted panel, home "The everyday collection"),
           inset (contained block on a dark/tinted scheme, collection "The art of layering"),
           split (photo + copy on the page background, collection "Crafted for your every day", product story).
  On product pages the text can come from the product metafield custom.product_story.
{%- endcomment -%}
{{ 'section-aurelia.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  assign body = s.text
  if s.use_product_story and product != blank
    assign story = product.metafields.custom.product_story | metafield_tag
    if story != blank
      assign body = story
    endif
  endif
  assign img = s.image
  if img == blank and s.use_product_image and product != blank
    assign img = product.media[1].preview_image | default: product.featured_media.preview_image
  endif
  case s.image_ratio
    when 'portrait'
      assign r = 'aspect-ratio: 4 / 5;'
    when 'landscape'
      assign r = 'aspect-ratio: 1 / .82;'
    when 'square'
      assign r = 'aspect-ratio: 1;'
    else
      assign r = ''
  endcase
-%}
<section class="iwt iwt--{{ s.layout }} iwt--img-{{ s.image_side }} color-{{ s.section_scheme }}{% if s.layout != 'panel' %} section{% endif %}{% if s.layout == 'split' and s.tight %} section--tight{% endif %}">
  <div class="iwt__wrap{% if s.layout != 'panel' %} page-width{% endif %}">
    <div class="iwt__grid{% if s.layout == 'inset' %} color-{{ s.color_scheme }}{% endif %}" style="--min-h: {{ s.min_height }}px;">
      <div class="iwt__media{% if r == blank %} iwt__media--fill{% endif %}" style="{{ r }}">
        {%- render 'responsive-image', image: img, max: 1800, sizes: '(min-width: 750px) 50vw, 100vw', class: 'iwt__img', art: s.placeholder_art -%}
      </div>
      <div class="iwt__copy{% if s.layout == 'panel' %} color-{{ s.color_scheme }}{% endif %}">
        <div class="iwt__inner" data-reveal>
          {%- if s.kicker != blank -%}<p class="kicker{% if s.kicker_plain %} iwt__kicker--plain{% endif %}">{{ s.kicker | escape }}</p>{%- endif -%}
          {%- if s.heading != blank -%}<h2 class="h2 iwt__title">{{ s.heading | escape }}</h2>{%- endif -%}
          {%- if body != blank -%}<div class="iwt__text rte">{{ body }}</div>{%- endif -%}
          {%- render 'button', label: s.button_label, url: s.button_link, style: s.button_style -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image with text",
  "class": "section-image-with-text",
  "settings": [
    {
      "type": "select", "id": "layout", "label": "Layout",
      "options": [
        { "value": "panel", "label": "Full width with color panel" },
        { "value": "inset", "label": "Contained block" },
        { "value": "split", "label": "Split on page background" }
      ],
      "default": "panel"
    },
    {
      "type": "select", "id": "image_side", "label": "Image position",
      "options": [{ "value": "left", "label": "Left" }, { "value": "right", "label": "Right" }],
      "default": "left"
    },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "checkbox", "id": "use_product_image", "label": "Use the product's second image on product pages", "default": false },
    {
      "type": "select", "id": "image_ratio", "label": "Image shape",
      "options": [{ "value": "fill", "label": "Fill the height" }, { "value": "portrait", "label": "Portrait 4:5" }, { "value": "landscape", "label": "Landscape" }, { "value": "square", "label": "Square" }],
      "default": "fill"
    },
    {
      "type": "select", "id": "placeholder_art", "label": "Placeholder drawing",
      "options": [{ "value": "necklace", "label": "Necklace" }, { "value": "ring", "label": "Ring" }, { "value": "stack", "label": "Ring stack" }, { "value": "bust", "label": "Bust" }, { "value": "gift", "label": "Gift box" }],
      "default": "necklace"
    },
    { "type": "range", "id": "min_height", "label": "Minimum height", "min": 300, "max": 720, "step": 20, "unit": "px", "default": 460 },
    { "type": "text", "id": "kicker", "label": "Eyebrow", "default": "The edit" },
    { "type": "checkbox", "id": "kicker_plain", "label": "Eyebrow in text color (not gold)", "default": true },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The everyday collection" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Designed to elevate the moments that matter.</p>" },
    { "type": "checkbox", "id": "use_product_story", "label": "Use product story metafield on product pages", "info": "Shows custom.product_story when the product has one.", "default": false },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop everyday jewellery" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    {
      "type": "select", "id": "button_style", "label": "Button style",
      "options": [{ "value": "link", "label": "Underlined link" }, { "value": "solid", "label": "Solid" }, { "value": "outline", "label": "Outline" }],
      "default": "link"
    },
    { "type": "checkbox", "id": "tight", "label": "Reduce top spacing", "default": false },
    { "type": "color_scheme", "id": "color_scheme", "label": "Panel color scheme", "default": "scheme-4" },
    { "type": "color_scheme", "id": "section_scheme", "label": "Section background", "default": "scheme-1" }
  ],
  "presets": [
    { "name": "Image with text" },
    {
      "name": "Image with text — dark block",
      "settings": {
        "layout": "inset", "color_scheme": "scheme-7", "kicker": "The Aurelia edit", "kicker_plain": false, "heading": "The art of layering",
        "text": "<p>Build a collection that feels entirely your own, from delicate essentials to unmistakable statement pieces.</p>",
        "button_label": "Explore styling notes", "placeholder_art": "stack"
      }
    },
    {
      "name": "Image with text — split",
      "settings": {
        "layout": "split", "image_ratio": "landscape", "kicker": "Our approach", "heading": "Crafted for your every day",
        "text": "<p>Every Aurelia piece is thoughtfully designed to feel effortless, distinctive, and enduring.</p>",
        "button_label": "Discover our story", "placeholder_art": "ring"
      }
    }
  ]
}
{% endschema %}
