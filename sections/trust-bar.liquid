{%- comment -%} Trust strip — hairline-divided promises (icon, title, short line). Home: with icons; product page: uppercase titles. {%- endcomment -%}
{{ 'section-aurelia.css' | asset_url | stylesheet_tag }}
{%- assign s = section.settings -%}
<section class="trust-strip color-{{ s.color_scheme }}{% if s.caps %} trust-strip--caps{% endif %}{% if s.full_width %} trust-strip--full{% endif %}">
  <div class="{% unless s.full_width %}page-width{% endunless %}">
    <ul class="trust-strip__list" role="list" style="--cols: {{ section.blocks.size | at_least: 1 | at_most: 4 }};">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <li class="trust-strip__item" {{ block.shopify_attributes }}>
          {%- if s.show_icons and b.icon != 'none' -%}<span class="trust-strip__icon">{%- render 'icon', name: b.icon, size: 21 -%}</span>{%- endif -%}
          <div class="trust-strip__body">
            {%- if b.link != blank -%}
              <a class="trust-strip__title" href="{{ b.link }}">{{ b.title | escape }}</a>
            {%- else -%}
              <p class="trust-strip__title">{{ b.title | escape }}</p>
            {%- endif -%}
            {%- if b.text != blank -%}<p class="trust-strip__text">{{ b.text | escape }}</p>{%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.trust-bar.name",
  "class": "section-trust",
  "max_blocks": 4,
  "settings": [
    {
      "type": "checkbox",
      "id": "show_icons",
      "label": "t:sections.trust-bar.settings.show_icons.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "caps",
      "label": "t:sections.trust-bar.settings.caps.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "t:sections.trust-bar.settings.full_width.label",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.trust-bar.settings.color_scheme.label",
      "default": "scheme-2"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "t:sections.trust-bar.blocks.item.name",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "t:sections.trust-bar.blocks.item.settings.icon.label",
          "options": [
            {
              "value": "truck",
              "label": "t:sections.trust-bar.blocks.item.settings.icon.options__1.label"
            },
            {
              "value": "return",
              "label": "t:sections.trust-bar.blocks.item.settings.icon.options__2.label"
            },
            {
              "value": "gem",
              "label": "t:sections.trust-bar.blocks.item.settings.icon.options__3.label"
            },
            {
              "value": "shield-check",
              "label": "t:sections.trust-bar.blocks.item.settings.icon.options__4.label"
            },
            {
              "value": "award",
              "label": "t:sections.trust-bar.blocks.item.settings.icon.options__5.label"
            },
            {
              "value": "gift",
              "label": "t:sections.trust-bar.blocks.item.settings.icon.options__6.label"
            },
            {
              "value": "pen",
              "label": "t:sections.trust-bar.blocks.item.settings.icon.options__7.label"
            },
            {
              "value": "package",
              "label": "t:sections.trust-bar.blocks.item.settings.icon.options__8.label"
            },
            {
              "value": "credit-card",
              "label": "t:sections.trust-bar.blocks.item.settings.icon.options__9.label"
            },
            {
              "value": "sparkle",
              "label": "t:sections.trust-bar.blocks.item.settings.icon.options__10.label"
            },
            {
              "value": "leaf",
              "label": "t:sections.trust-bar.blocks.item.settings.icon.options__11.label"
            },
            {
              "value": "none",
              "label": "t:sections.trust-bar.blocks.item.settings.icon.options__12.label"
            }
          ],
          "default": "truck"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.trust-bar.blocks.item.settings.title.label",
          "default": "Free shipping"
        },
        {
          "type": "text",
          "id": "text",
          "label": "t:sections.trust-bar.blocks.item.settings.text.label",
          "default": "On orders over $100"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.trust-bar.blocks.item.settings.link.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.trust-bar.presets.presets__1.name",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "icon": "truck",
            "title": "Free shipping",
            "text": "On orders over $100"
          }
        },
        {
          "type": "item",
          "settings": {
            "icon": "return",
            "title": "30-day returns",
            "text": "Shop with confidence"
          }
        },
        {
          "type": "item",
          "settings": {
            "icon": "gem",
            "title": "Premium quality",
            "text": "Made to last"
          }
        },
        {
          "type": "item",
          "settings": {
            "icon": "shield-check",
            "title": "Secure checkout",
            "text": "Safe & protected payments"
          }
        }
      ]
    }
  ]
}
{% endschema %}
