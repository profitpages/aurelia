{{ 'section-extras.css' | asset_url | stylesheet_tag }}
{%- assign s = section.settings -%}
{%- capture items -%}
  {%- for block in section.blocks -%}
    <span class="marquee__item" {{ block.shopify_attributes }}>
      {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{{ block.settings.text | escape }}</a>{%- else -%}{{ block.settings.text | escape }}{%- endif -%}
    </span>
    <span class="marquee__sep" aria-hidden="true">{% render 'icon', name: s.separator, size: 18 %}</span>
  {%- endfor -%}
{%- endcapture -%}
<section class="marquee color-{{ s.color_scheme }} marquee--{{ s.direction }}{% if s.serif %} marquee--serif{% endif %}" style="--speed: {{ s.speed }}s;" aria-label="{{ s.label | escape }}">
  <div class="marquee__track">
    <div class="marquee__group">{{ items }}</div>
    <div class="marquee__group" aria-hidden="true">{{ items }}</div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.marquee.name",
  "class": "section-marquee",
  "max_blocks": 10,
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "t:sections.marquee.settings.label.label",
      "default": "Brand promises"
    },
    {
      "type": "select",
      "id": "separator",
      "label": "t:sections.marquee.settings.separator.label",
      "options": [
        {
          "value": "sparkle",
          "label": "t:sections.marquee.settings.separator.options__1.label"
        },
        {
          "value": "flower",
          "label": "t:sections.marquee.settings.separator.options__2.label"
        },
        {
          "value": "dot",
          "label": "t:sections.marquee.settings.separator.options__3.label"
        },
        {
          "value": "leaf",
          "label": "t:sections.marquee.settings.separator.options__4.label"
        }
      ],
      "default": "sparkle"
    },
    {
      "type": "checkbox",
      "id": "serif",
      "label": "t:sections.marquee.settings.serif.label",
      "default": true
    },
    {
      "type": "range",
      "id": "speed",
      "label": "t:sections.marquee.settings.speed.label",
      "min": 16,
      "max": 80,
      "step": 4,
      "unit": "s",
      "default": 40
    },
    {
      "type": "select",
      "id": "direction",
      "label": "t:sections.marquee.settings.direction.label",
      "options": [
        {
          "value": "left",
          "label": "t:sections.marquee.settings.direction.options__1.label"
        },
        {
          "value": "right",
          "label": "t:sections.marquee.settings.direction.options__2.label"
        }
      ],
      "default": "left"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.marquee.settings.color_scheme.label",
      "default": "scheme-4"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "t:sections.marquee.blocks.item.name",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "t:sections.marquee.blocks.item.settings.text.label",
          "default": "Hypoallergenic"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.marquee.blocks.item.settings.link.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.marquee.presets.presets__1.name",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "text": "Hypoallergenic"
          }
        },
        {
          "type": "item",
          "settings": {
            "text": "Hypoallergenic"
          }
        },
        {
          "type": "item",
          "settings": {
            "text": "Free engraving"
          }
        },
        {
          "type": "item",
          "settings": {
            "text": "Free shipping over $100"
          }
        },
        {
          "type": "item",
          "settings": {
            "text": "Gift-ready packaging"
          }
        }
      ]
    }
  ]
}
{% endschema %}
