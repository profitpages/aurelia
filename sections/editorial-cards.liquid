{%- comment -%} Editorial cards — tall photo cards with a title, a short line and a call to action (Canva "Shop by moment"). {%- endcomment -%}
{{ 'section-aurelia.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  assign arts = 'necklace,earrings,ring,gift,bracelet,stack' | split: ','
-%}
<section class="section color-{{ s.color_scheme }}">
  <div class="page-width">
    {%- render 'section-heading', kicker: s.kicker, title: s.heading, text: s.text, align: s.heading_align -%}
    <ul class="ecards" role="list" style="--cols: {{ section.blocks.size | at_least: 1 | at_most: 4 }}; --card-h: {{ s.card_height }}px;">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        {%- assign i = forloop.index0 | modulo: 6 -%}
        {%- assign url = b.link | default: b.collection.url | default: routes.all_products_collection_url -%}
        {%- assign img = b.image | default: b.collection.featured_image -%}
        <li class="ecard" {{ block.shopify_attributes }}>
          <a class="ecard__link" href="{{ url }}" data-reveal>
            <span class="ecard__media">{%- render 'responsive-image', image: img, max: 1000, sizes: '(min-width: 990px) 25vw, 80vw', class: 'ecard__img', art: arts[i], alt: '' -%}</span>
            <span class="ecard__shade" aria-hidden="true"></span>
            <span class="ecard__body">
              <span class="ecard__title">{{ b.title | escape }}</span>
              {%- if b.text != blank -%}<span class="ecard__text">{{ b.text | escape }}</span>{%- endif -%}
              {%- if b.link_label != blank -%}<span class="ecard__go">{{ b.link_label | escape | replace: ' →', '&nbsp;→' }}</span>{%- endif -%}
            </span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Editorial cards",
  "class": "section-editorial-cards",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "kicker", "label": "Eyebrow", "default": "Shop by moment" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find the perfect piece" },
    { "type": "richtext", "id": "text", "label": "Text" },
    {
      "type": "select", "id": "heading_align", "label": "Heading alignment",
      "options": [{ "value": "center", "label": "Center" }, { "value": "left", "label": "Left" }],
      "default": "center"
    },
    { "type": "range", "id": "card_height", "label": "Card height", "min": 300, "max": 560, "step": 10, "unit": "px", "default": 370 },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "blocks": [
    {
      "type": "card", "name": "Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Portrait images work best. Defaults to the collection image." },
        { "type": "text", "id": "title", "label": "Title", "default": "Everyday" },
        { "type": "text", "id": "text", "label": "Text", "default": "Effortless pieces for every day" },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "Shop the edit →" },
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "url", "id": "link", "label": "Custom link", "info": "Overrides the collection link." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Editorial cards",
      "blocks": [
        { "type": "card", "settings": { "title": "Everyday", "text": "Effortless pieces for every day" } },
        { "type": "card", "settings": { "title": "Date night", "text": "Make an unforgettable impression" } },
        { "type": "card", "settings": { "title": "Celebration", "text": "Jewellery for life's biggest moments" } },
        { "type": "card", "settings": { "title": "Gifting", "text": "Something they'll always remember" } }
      ]
    }
  ]
}
{% endschema %}
