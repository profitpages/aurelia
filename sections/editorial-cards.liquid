{%- comment -%} Editorial cards — tall photo cards with a title, a short line and a call to action (Canva "Shop by moment"). {%- endcomment -%}
{{ 'section-aurelia.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  assign arts = 'necklace,earrings,ring,gift,bracelet,stack' | split: ','
-%}
<section class="section color-{{ s.color_scheme }}">
  <div class="page-width">
    {%- render 'section-heading', kicker: s.kicker, title: s.heading, text: s.text, align: s.heading_align -%}
    <ul class="ecards" role="list" style="--cols: {{ section.blocks.size | at_least: 1 | at_most: 4 }}; --card-h: {{ s.card_height }}px;">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        {%- assign i = forloop.index0 | modulo: 6 -%}
        {%- assign url = b.link | default: b.collection.url | default: routes.all_products_collection_url -%}
        {%- assign img = b.image | default: b.collection.featured_image -%}
        <li class="ecard" {{ block.shopify_attributes }}>
          <a class="ecard__link" href="{{ url }}" data-reveal>
            <span class="ecard__media">{%- render 'responsive-image', image: img, max: 1000, sizes: '(min-width: 990px) 25vw, 80vw', class: 'ecard__img', art: arts[i], alt: '' -%}</span>
            <span class="ecard__shade" aria-hidden="true"></span>
            <span class="ecard__body">
              <span class="ecard__title">{{ b.title | escape }}</span>
              {%- if b.text != blank -%}<span class="ecard__text">{{ b.text | escape }}</span>{%- endif -%}
              {%- if b.link_label != blank -%}<span class="ecard__go">{{ b.link_label | escape | replace: ' →', '&nbsp;→' }}</span>{%- endif -%}
            </span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.editorial-cards.name",
  "class": "section-editorial-cards",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "t:sections.editorial-cards.settings.kicker.label",
      "default": "Shop by moment"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.editorial-cards.settings.heading.label",
      "default": "Find the perfect piece"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.editorial-cards.settings.text.label"
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "t:sections.editorial-cards.settings.heading_align.label",
      "options": [
        {
          "value": "center",
          "label": "t:sections.editorial-cards.settings.heading_align.options__1.label"
        },
        {
          "value": "left",
          "label": "t:sections.editorial-cards.settings.heading_align.options__2.label"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "card_height",
      "label": "t:sections.editorial-cards.settings.card_height.label",
      "min": 300,
      "max": 560,
      "step": 10,
      "unit": "px",
      "default": 370
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.editorial-cards.settings.color_scheme.label",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "t:sections.editorial-cards.blocks.card.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.editorial-cards.blocks.card.settings.image.label",
          "info": "t:sections.editorial-cards.blocks.card.settings.image.info"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.editorial-cards.blocks.card.settings.title.label",
          "default": "Everyday"
        },
        {
          "type": "text",
          "id": "text",
          "label": "t:sections.editorial-cards.blocks.card.settings.text.label",
          "default": "Effortless pieces for every day"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "t:sections.editorial-cards.blocks.card.settings.link_label.label",
          "default": "Shop the edit →"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "t:sections.editorial-cards.blocks.card.settings.collection.label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.editorial-cards.blocks.card.settings.link.label",
          "info": "t:sections.editorial-cards.blocks.card.settings.link.info"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.editorial-cards.presets.presets__1.name",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "title": "Everyday",
            "text": "Effortless pieces for every day"
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "Date night",
            "text": "Make an unforgettable impression"
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "Celebration",
            "text": "Jewellery for life's biggest moments"
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "Gifting",
            "text": "Something they'll always remember"
          }
        }
      ]
    }
  ]
}
{% endschema %}
