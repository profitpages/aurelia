{%- comment -%} Bespoke process — a sticky photograph beside numbered steps divided by hairlines (consultation → design → craft → delivery). {%- endcomment -%}
{{ 'section-aurelia-extras.css' | asset_url | stylesheet_tag }}
{%- assign s = section.settings -%}
<section class="section color-{{ s.color_scheme }}">
  <div class="page-width">
    <div class="bespoke bespoke--img-{{ s.image_side }}">
      <div class="bespoke__media">
        {%- render 'responsive-image', image: s.image, max: 1400, sizes: '(min-width: 990px) 45vw, 100vw', class: 'bespoke__img', art: 'ring', alt: '' -%}
      </div>
      <div class="bespoke__copy">
        {%- render 'section-heading', kicker: s.kicker, title: s.heading, text: s.text -%}
        <ol class="bespoke__steps" role="list">
          {%- for block in section.blocks -%}
            <li class="bespoke__step" data-reveal {{ block.shopify_attributes }}>
              <span class="bespoke__num" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
              <div>
                <h3 class="bespoke__title">{{ block.settings.title | escape }}</h3>
                {%- if block.settings.text != blank -%}<p class="bespoke__text">{{ block.settings.text | escape }}</p>{%- endif -%}
              </div>
            </li>
          {%- endfor -%}
        </ol>
        {%- if s.button_label != blank -%}<div class="bespoke__cta">{%- render 'button', label: s.button_label, url: s.button_link, style: 'solid' -%}</div>{%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.bespoke-process.name",
  "class": "section-bespoke",
  "max_blocks": 6,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.bespoke-process.settings.image.label"
    },
    {
      "type": "select",
      "id": "image_side",
      "label": "t:sections.bespoke-process.settings.image_side.label",
      "options": [
        {
          "value": "left",
          "label": "t:sections.bespoke-process.settings.image_side.options__1.label"
        },
        {
          "value": "right",
          "label": "t:sections.bespoke-process.settings.image_side.options__2.label"
        }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "t:sections.bespoke-process.settings.kicker.label",
      "default": "Bespoke"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.bespoke-process.settings.heading.label",
      "default": "Designed with you, made by hand"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.bespoke-process.settings.text.label",
      "default": "<p>From an engagement ring to a family heirloom reimagined, our bespoke service takes your idea from sketch to finished piece.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.bespoke-process.settings.button_label.label",
      "default": "Book a consultation"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.bespoke-process.settings.button_link.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.bespoke-process.settings.color_scheme.label",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "t:sections.bespoke-process.blocks.step.name",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.bespoke-process.blocks.step.settings.title.label",
          "default": "Consultation"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "t:sections.bespoke-process.blocks.step.settings.text.label",
          "default": "Meet a designer in the atelier or by video to talk through your idea and budget."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.bespoke-process.presets.presets__1.name",
      "blocks": [
        {
          "type": "step"
        },
        {
          "type": "step",
          "settings": {
            "title": "Design",
            "text": "We sketch and render your piece, refining every detail until it feels right."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Craft",
            "text": "Your piece is cast, set and polished by hand in our studio."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Delivery",
            "text": "Presented in our signature box, insured and delivered to your door."
          }
        }
      ]
    }
  ]
}
{% endschema %}
