{%- comment -%} Slideshow — full-bleed Aurelia hero slides (photo, tonal overlay, editorial copy). {%- endcomment -%}
{{ 'section-hero.css' | asset_url | stylesheet_tag }}
{{ 'section-extras.css' | asset_url | stylesheet_tag }}
{%- assign s = section.settings -%}
<slide-show class="slideshow slideshow--{{ s.height }}" data-autoplay="{{ s.autoplay }}" data-interval="{{ s.interval | times: 1000 }}" aria-roledescription="carousel" aria-label="{{ s.label | escape }}">
  <div class="slideshow__track">
    {%- for block in section.blocks -%}
      {%- assign b = block.settings -%}
      {%- capture htag -%}{% if section.index == 1 and forloop.first %}h1{% else %}h2{% endif %}{%- endcapture -%}
      {%- liquid
        assign eager = false
        if section.index == 1 and forloop.first
          assign eager = true
        endif
      -%}
      <div class="slideshow__slide hero hero--{{ s.height }} hero--x-{{ b.content_x }} hero--y-bottom hero--text-light color-{{ b.color_scheme }}{% if forloop.first %} is-active{% endif %}" style="--hero-overlay: {{ b.overlay | divided_by: 100.0 }};" role="group" aria-roledescription="slide" aria-label="{{ 'sections.slide_x_of_y' | t: index: forloop.index, count: forloop.length }}"{% unless forloop.first %} aria-hidden="true"{% endunless %} data-slide {{ block.shopify_attributes }}>
        <div class="hero__media" aria-hidden="true">
          {%- if b.image != blank -%}
            {%- render 'responsive-image', image: b.image, max: 2800, sizes: '100vw', class: 'hero__img', eager: eager, alt: '' -%}
          {%- else -%}
            <div class="hero__art">{%- render 'cosmetic-art', name: b.art -%}</div>
          {%- endif -%}
        </div>
        <div class="hero__shade" aria-hidden="true"></div>
        <div class="hero__content page-width">
          <div class="hero__copy">
            {%- if b.kicker != blank -%}<p class="kicker hero__kicker">{{ b.kicker | escape }}</p>{%- endif -%}
            {%- if b.heading != blank -%}<{{ htag }} class="display hero__title">{{ b.heading | escape }}</{{ htag }}>{%- endif -%}
            {%- if b.text != blank -%}<div class="hero__text rte">{{ b.text }}</div>{%- endif -%}
            <div class="btn-row hero__buttons">
              {%- render 'button', label: b.button_label, url: b.button_link, style: 'light' -%}
              {%- render 'button', label: b.button2_label, url: b.button2_link, style: 'ghost-light' -%}
            </div>
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>
  {%- if section.blocks.size > 1 -%}
    <div class="slideshow__controls page-width">
      <button class="circle-btn" type="button" data-prev aria-label="{{ 'general.previous' | t }}">{% render 'icon', name: 'arrow-left', size: 18 %}</button>
      <div class="slideshow__dots" role="group" aria-label="{{ 'sections.choose_slide' | t }}">
        {%- for block in section.blocks -%}
          <button class="slideshow__dot{% if forloop.first %} is-active{% endif %}" type="button" data-dot="{{ forloop.index0 }}" aria-label="{{ 'sections.slide_x_of_y' | t: index: forloop.index, count: forloop.length }}"{% if forloop.first %} aria-current="true"{% endif %}></button>
        {%- endfor -%}
      </div>
      <button class="circle-btn" type="button" data-next aria-label="{{ 'general.next' | t }}">{% render 'icon', name: 'arrow-right', size: 18 %}</button>
      {%- if s.autoplay -%}
        <button class="circle-btn slideshow__pause" type="button" data-pause aria-label="{{ 'sections.pause' | t }}" data-label-pause="{{ 'sections.pause' | t }}" data-label-play="{{ 'sections.play' | t }}"><span class="slideshow__pause-icon" aria-hidden="true"></span></button>
      {%- endif -%}
    </div>
  {%- endif -%}
</slide-show>

{% schema %}
{
  "name": "Slideshow",
  "class": "section-slideshow",
  "max_blocks": 5,
  "settings": [
    { "type": "text", "id": "label", "label": "Accessible name", "default": "Featured collections" },
    {
      "type": "select", "id": "height", "label": "Height",
      "options": [{ "value": "sm", "label": "Small" }, { "value": "md", "label": "Medium" }, { "value": "lg", "label": "Large" }],
      "default": "lg"
    },
    { "type": "checkbox", "id": "autoplay", "label": "Auto-rotate slides", "default": true },
    { "type": "range", "id": "interval", "label": "Change every", "min": 3, "max": 10, "step": 1, "unit": "s", "default": 6 }
  ],
  "blocks": [
    {
      "type": "slide", "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image", "info": "2800 × 1500px or larger." },
        {
          "type": "select", "id": "art", "label": "Placeholder drawing (no image)",
          "options": [{ "value": "bust", "label": "Necklace on bust" }, { "value": "ring", "label": "Ring" }, { "value": "stack", "label": "Ring stack" }, { "value": "earrings", "label": "Earrings" }, { "value": "bracelet", "label": "Bracelet" }],
          "default": "bust"
        },
        { "type": "range", "id": "overlay", "label": "Overlay strength", "min": 0, "max": 90, "step": 5, "unit": "%", "default": 45 },
        {
          "type": "select", "id": "content_x", "label": "Content position",
          "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" }],
          "default": "left"
        },
        { "type": "text", "id": "kicker", "label": "Eyebrow", "default": "The Aurelia collection" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Jewelry that tells your story" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Timeless pieces designed to become part of your everyday.</p>" },
        { "type": "text", "id": "button_label", "label": "Ivory button", "default": "Shop now" },
        { "type": "url", "id": "button_link", "label": "Ivory button link" },
        { "type": "text", "id": "button2_label", "label": "Outline button" },
        { "type": "url", "id": "button2_link", "label": "Outline button link" },
        { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-5" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Slideshow",
      "blocks": [
        { "type": "slide" },
        { "type": "slide", "settings": { "kicker": "Just landed", "heading": "New arrivals", "art": "earrings", "content_x": "center", "text": "<p>Meet the latest additions to our collection.</p>" } },
        { "type": "slide", "settings": { "kicker": "Aurelia icons", "heading": "The signature collection", "art": "stack", "text": "<p>Iconic pieces designed to become timeless essentials.</p>" } }
      ]
    }
  ]
}
{% endschema %}
