{%- comment -%} Slideshow — full-bleed Aurelia hero slides (photo, tonal overlay, editorial copy). {%- endcomment -%}
{{ 'section-hero.css' | asset_url | stylesheet_tag }}
{{ 'section-extras.css' | asset_url | stylesheet_tag }}
{%- assign s = section.settings -%}
<slide-show class="slideshow slideshow--{{ s.height }}" data-autoplay="{{ s.autoplay }}" data-interval="{{ s.interval | times: 1000 }}" aria-roledescription="carousel" aria-label="{{ s.label | escape }}">
  <div class="slideshow__track">
    {%- for block in section.blocks -%}
      {%- assign b = block.settings -%}
      {%- capture htag -%}{% if section.index == 1 and forloop.first %}h1{% else %}h2{% endif %}{%- endcapture -%}
      {%- liquid
        assign eager = false
        if section.index == 1 and forloop.first
          assign eager = true
        endif
      -%}
      <div class="slideshow__slide hero hero--{{ s.height }} hero--x-{{ b.content_x }} hero--y-bottom hero--text-light color-{{ b.color_scheme }}{% if forloop.first %} is-active{% endif %}" style="--hero-overlay: {{ b.overlay | divided_by: 100.0 }};" role="group" aria-roledescription="slide" aria-label="{{ 'sections.slide_x_of_y' | t: index: forloop.index, count: forloop.length }}"{% unless forloop.first %} aria-hidden="true"{% endunless %} data-slide {{ block.shopify_attributes }}>
        <div class="hero__media" aria-hidden="true">
          {%- if b.image != blank -%}
            {%- render 'responsive-image', image: b.image, max: 2800, sizes: '100vw', class: 'hero__img', eager: eager, alt: '' -%}
          {%- else -%}
            <div class="hero__art">{%- render 'cosmetic-art', name: b.art -%}</div>
          {%- endif -%}
        </div>
        <div class="hero__shade" aria-hidden="true"></div>
        <div class="hero__content page-width">
          <div class="hero__copy">
            {%- if b.kicker != blank -%}<p class="kicker hero__kicker">{{ b.kicker | escape }}</p>{%- endif -%}
            {%- if b.heading != blank -%}<{{ htag }} class="display hero__title">{{ b.heading | escape }}</{{ htag }}>{%- endif -%}
            {%- if b.text != blank -%}<div class="hero__text rte">{{ b.text }}</div>{%- endif -%}
            <div class="btn-row hero__buttons">
              {%- render 'button', label: b.button_label, url: b.button_link, style: 'light' -%}
              {%- render 'button', label: b.button2_label, url: b.button2_link, style: 'ghost-light' -%}
            </div>
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>
  {%- if section.blocks.size > 1 -%}
    <div class="slideshow__controls page-width">
      <button class="circle-btn" type="button" data-prev aria-label="{{ 'general.previous' | t }}">{% render 'icon', name: 'arrow-left', size: 18 %}</button>
      <div class="slideshow__dots" role="group" aria-label="{{ 'sections.choose_slide' | t }}">
        {%- for block in section.blocks -%}
          <button class="slideshow__dot{% if forloop.first %} is-active{% endif %}" type="button" data-dot="{{ forloop.index0 }}" aria-label="{{ 'sections.slide_x_of_y' | t: index: forloop.index, count: forloop.length }}"{% if forloop.first %} aria-current="true"{% endif %}></button>
        {%- endfor -%}
      </div>
      <button class="circle-btn" type="button" data-next aria-label="{{ 'general.next' | t }}">{% render 'icon', name: 'arrow-right', size: 18 %}</button>
      {%- if s.autoplay -%}
        <button class="circle-btn slideshow__pause" type="button" data-pause aria-label="{{ 'sections.pause' | t }}" data-label-pause="{{ 'sections.pause' | t }}" data-label-play="{{ 'sections.play' | t }}"><span class="slideshow__pause-icon" aria-hidden="true"></span></button>
      {%- endif -%}
    </div>
  {%- endif -%}
</slide-show>

{% schema %}
{
  "name": "t:sections.slideshow.name",
  "class": "section-slideshow",
  "max_blocks": 5,
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "t:sections.slideshow.settings.label.label",
      "default": "Featured collections"
    },
    {
      "type": "select",
      "id": "height",
      "label": "t:sections.slideshow.settings.height.label",
      "options": [
        {
          "value": "sm",
          "label": "t:sections.slideshow.settings.height.options__1.label"
        },
        {
          "value": "md",
          "label": "t:sections.slideshow.settings.height.options__2.label"
        },
        {
          "value": "lg",
          "label": "t:sections.slideshow.settings.height.options__3.label"
        }
      ],
      "default": "lg"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "t:sections.slideshow.settings.autoplay.label",
      "default": true
    },
    {
      "type": "range",
      "id": "interval",
      "label": "t:sections.slideshow.settings.interval.label",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 6
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "t:sections.slideshow.blocks.slide.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.slideshow.blocks.slide.settings.image.label",
          "info": "t:sections.slideshow.blocks.slide.settings.image.info"
        },
        {
          "type": "select",
          "id": "art",
          "label": "t:sections.slideshow.blocks.slide.settings.art.label",
          "options": [
            {
              "value": "bust",
              "label": "t:sections.slideshow.blocks.slide.settings.art.options__1.label"
            },
            {
              "value": "ring",
              "label": "t:sections.slideshow.blocks.slide.settings.art.options__2.label"
            },
            {
              "value": "stack",
              "label": "t:sections.slideshow.blocks.slide.settings.art.options__3.label"
            },
            {
              "value": "earrings",
              "label": "t:sections.slideshow.blocks.slide.settings.art.options__4.label"
            },
            {
              "value": "bracelet",
              "label": "t:sections.slideshow.blocks.slide.settings.art.options__5.label"
            }
          ],
          "default": "bust"
        },
        {
          "type": "range",
          "id": "overlay",
          "label": "t:sections.slideshow.blocks.slide.settings.overlay.label",
          "min": 0,
          "max": 90,
          "step": 5,
          "unit": "%",
          "default": 45
        },
        {
          "type": "select",
          "id": "content_x",
          "label": "t:sections.slideshow.blocks.slide.settings.content_x.label",
          "options": [
            {
              "value": "left",
              "label": "t:sections.slideshow.blocks.slide.settings.content_x.options__1.label"
            },
            {
              "value": "center",
              "label": "t:sections.slideshow.blocks.slide.settings.content_x.options__2.label"
            },
            {
              "value": "right",
              "label": "t:sections.slideshow.blocks.slide.settings.content_x.options__3.label"
            }
          ],
          "default": "left"
        },
        {
          "type": "text",
          "id": "kicker",
          "label": "t:sections.slideshow.blocks.slide.settings.kicker.label",
          "default": "The Aurelia collection"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.slideshow.blocks.slide.settings.heading.label",
          "default": "Jewelry that tells your story"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:sections.slideshow.blocks.slide.settings.text.label",
          "default": "<p>Timeless pieces designed to become part of your everyday.</p>"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "t:sections.slideshow.blocks.slide.settings.button_label.label",
          "default": "Shop now"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "t:sections.slideshow.blocks.slide.settings.button_link.label"
        },
        {
          "type": "text",
          "id": "button2_label",
          "label": "t:sections.slideshow.blocks.slide.settings.button2_label.label"
        },
        {
          "type": "url",
          "id": "button2_link",
          "label": "t:sections.slideshow.blocks.slide.settings.button2_link.label"
        },
        {
          "type": "color_scheme",
          "id": "color_scheme",
          "label": "t:sections.slideshow.blocks.slide.settings.color_scheme.label",
          "default": "scheme-5"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.slideshow.presets.presets__1.name",
      "blocks": [
        {
          "type": "slide"
        },
        {
          "type": "slide",
          "settings": {
            "kicker": "Just landed",
            "heading": "New arrivals",
            "art": "earrings",
            "content_x": "center",
            "text": "<p>Meet the latest additions to our collection.</p>"
          }
        },
        {
          "type": "slide",
          "settings": {
            "kicker": "Aurelia icons",
            "heading": "The signature collection",
            "art": "stack",
            "text": "<p>Iconic pieces designed to become timeless essentials.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
