{%- comment -%} Shop by concern — photo cards (home) or chip links (collection pages). Each block links to a collection. {%- endcomment -%}
{{ 'section-content.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  assign arts = 'swatch,portrait,jar,serum,pump,tube' | split: ','
-%}
<section class="section{% if s.layout == 'chips' %} section--chips{% endif %} color-{{ s.color_scheme }}">
  <div class="page-width">
    {%- if s.layout == 'chips' -%}
      <div class="concern-chips">
        {%- if s.heading != blank -%}<h2 class="kicker">{{ s.heading | escape }}</h2>{%- endif -%}
        <ul class="chip-row" role="list">
          {%- for block in section.blocks -%}
            {%- assign b = block.settings -%}
            {%- assign url = b.link | default: b.collection.url | default: routes.all_products_collection_url -%}
            <li {{ block.shopify_attributes }}><a class="chip{% if b.collection != blank and collection.handle == b.collection.handle %} is-active{% endif %}" href="{{ url }}">{{ b.title | escape }}</a></li>
          {%- endfor -%}
        </ul>
      </div>
    {%- else -%}
      {%- render 'section-heading', kicker: s.kicker, title: s.heading, text: s.text -%}
      <ul class="concerns" role="list" style="--cols: {{ s.columns }};">
        {%- for block in section.blocks -%}
          {%- assign b = block.settings -%}
          {%- assign url = b.link | default: b.collection.url | default: routes.all_products_collection_url -%}
          {%- assign c_img = b.image | default: b.collection.featured_image -%}
          {%- assign i = forloop.index0 | modulo: 6 -%}
          <li class="concern" data-reveal {{ block.shopify_attributes }}>
            <a class="concern__link" href="{{ url }}">
              <span class="concern__media">
                {%- render 'responsive-image', image: c_img, max: 700, sizes: '(min-width: 990px) 22vw, (min-width: 750px) 30vw, 70vw', class: 'concern__img', art: arts[i], tone: 'blush' -%}
              </span>
              <span class="concern__title">{{ b.title | escape }}</span>
              {%- if b.text != blank -%}<span class="concern__text">{{ b.text | escape }}</span>{%- endif -%}
              {%- if s.link_label != blank -%}<span class="concern__go">{{ s.link_label | escape }}</span>{%- endif -%}
            </a>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Shop by occasion",
  "class": "section-concerns",
  "max_blocks": 8,
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "cards",
          "label": "Photo cards"
        },
        {
          "value": "chips",
          "label": "Chip links (compact)"
        }
      ],
      "default": "cards"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Something for every moment"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by occasion"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Card link label",
      "default": "Discover"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Cards per row (desktop)",
      "min": 3,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "concern",
      "name": "Concern",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Everyday"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Effortless pieces for every day."
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Defaults to the collection image."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Custom link",
          "info": "Overrides the collection, e.g. a filtered collection URL."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by occasion",
      "blocks": [
        {
          "type": "concern",
          "settings": {
            "title": "Everyday",
            "text": "Effortless pieces for every day."
          }
        },
        {
          "type": "concern",
          "settings": {
            "title": "Celebration",
            "text": "Pieces for life’s biggest moments."
          }
        },
        {
          "type": "concern",
          "settings": {
            "title": "Date night",
            "text": "Make an unforgettable impression."
          }
        },
        {
          "type": "concern",
          "settings": {
            "title": "Gifting",
            "text": "Gifts they will treasure."
          }
        }
      ]
    },
    {
      "name": "Occasion chips",
      "settings": {
        "layout": "chips",
        "heading": "Shop by occasion",
        "color_scheme": "scheme-2"
      },
      "blocks": [
        {
          "type": "concern",
          "settings": {
            "title": "Everyday"
          }
        },
        {
          "type": "concern",
          "settings": {
            "title": "Celebration"
          }
        },
        {
          "type": "concern",
          "settings": {
            "title": "Date night"
          }
        },
        {
          "type": "concern",
          "settings": {
            "title": "Gifting"
          }
        },
        {
          "type": "concern",
          "settings": {
            "title": "Wedding"
          }
        }
      ]
    }
  ]
}
{% endschema %}
