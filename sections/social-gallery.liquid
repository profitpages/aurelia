{%- comment -%} Social gallery — six square photos linking to posts or the Instagram profile (Canva "As seen on you"). {%- endcomment -%}
{{ 'section-aurelia.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  assign arts = 'ring,necklace,earrings,bracelet,stack,gift' | split: ','
  assign profile = s.profile_link | default: settings.social_instagram
-%}
<section class="section color-{{ s.color_scheme }}">
  <div class="page-width">
    {%- render 'section-heading', kicker: s.kicker, title: s.heading, text: s.text, align: 'center' -%}
    <ul class="social-grid" role="list" style="--cols: {{ s.columns }};">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        {%- assign i = forloop.index0 | modulo: 6 -%}
        {%- assign url = b.link | default: b.product.url | default: profile -%}
        {%- capture alt -%}{% if b.alt != blank %}{{ b.alt }}{% else %}{{ 'sections.social_post' | t: index: forloop.index }}{% endif %}{%- endcapture -%}
        <li {{ block.shopify_attributes }}>
          {%- if url != blank -%}
            <a class="social-grid__tile" href="{{ url }}"{% if b.product == blank %} target="_blank" rel="noopener"{% endif %} aria-label="{{ alt | escape }}">
              {%- render 'responsive-image', image: b.image, max: 700, sizes: '(min-width: 990px) 16vw, 48vw', class: 'social-grid__img', art: arts[i], alt: '' -%}
              <span class="social-grid__icon" aria-hidden="true">{% render 'icon', name: 'instagram', size: 22 %}</span>
            </a>
          {%- else -%}
            <span class="social-grid__tile">{%- render 'responsive-image', image: b.image, max: 700, sizes: '(min-width: 990px) 16vw, 48vw', class: 'social-grid__img', art: arts[i], alt: alt -%}</span>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.social-gallery.name",
  "class": "section-social-gallery",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "t:sections.social-gallery.settings.kicker.label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.social-gallery.settings.heading.label",
      "default": "As seen on you"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.social-gallery.settings.text.label",
      "default": "<p>Share your style with @aureliajewellery</p>"
    },
    {
      "type": "url",
      "id": "profile_link",
      "label": "t:sections.social-gallery.settings.profile_link.label",
      "info": "t:sections.social-gallery.settings.profile_link.info"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:sections.social-gallery.settings.columns.label",
      "min": 3,
      "max": 6,
      "step": 1,
      "default": 6
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.social-gallery.settings.color_scheme.label",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "t:sections.social-gallery.blocks.photo.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.social-gallery.blocks.photo.settings.image.label"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "t:sections.social-gallery.blocks.photo.settings.alt.label"
        },
        {
          "type": "product",
          "id": "product",
          "label": "t:sections.social-gallery.blocks.photo.settings.product.label",
          "info": "t:sections.social-gallery.blocks.photo.settings.product.info"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.social-gallery.blocks.photo.settings.link.label",
          "info": "t:sections.social-gallery.blocks.photo.settings.link.info"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.social-gallery.presets.presets__1.name",
      "blocks": [
        {
          "type": "photo"
        },
        {
          "type": "photo"
        },
        {
          "type": "photo"
        },
        {
          "type": "photo"
        },
        {
          "type": "photo"
        },
        {
          "type": "photo"
        }
      ]
    }
  ]
}
{% endschema %}
