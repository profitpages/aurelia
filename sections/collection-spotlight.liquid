{%- comment -%} Collection spotlight — a tall editorial photo panel beside a scrollable rail of the collection's products. {%- endcomment -%}
{{ 'section-aurelia-extras.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  assign c = s.collection
  assign img = s.image | default: c.image
  assign title = s.heading | default: c.title
  assign url = s.link | default: c.url | default: routes.all_products_collection_url
-%}
<section class="section color-{{ s.color_scheme }}">
  <div class="page-width">
    <div class="spot spot--panel-{{ s.panel_side }}">
      <a class="spot__panel" href="{{ url }}">
        <span class="spot__media">{%- render 'responsive-image', image: img, max: 1400, sizes: '(min-width: 990px) 36vw, 100vw', class: 'spot__img', art: 'bust', alt: '' -%}</span>
        <span class="spot__shade" aria-hidden="true"></span>
        <span class="spot__copy">
          {%- if s.kicker != blank -%}<span class="kicker spot__kicker">{{ s.kicker | escape }}</span>{%- endif -%}
          <span class="spot__title">{{ title | escape }}</span>
          {%- if s.text != blank -%}<span class="spot__text">{{ s.text | escape }}</span>{%- endif -%}
          {%- if s.link_label != blank -%}<span class="spot__go">{{ s.link_label | escape | replace: ' →', '&nbsp;→' }}</span>{%- endif -%}
        </span>
      </a>
      <div class="spot__rail">
        <div class="spot__head">
          {%- if s.rail_heading != blank -%}<h2 class="h3 spot__rail-title">{{ s.rail_heading | escape }}</h2>{%- endif -%}
          <div class="rail-arrows">
            <button class="circle-btn" type="button" data-rail="prev" aria-label="{{ 'general.previous' | t }}">{% render 'icon', name: 'arrow-left', size: 18 %}</button>
            <button class="circle-btn" type="button" data-rail="next" aria-label="{{ 'general.next' | t }}">{% render 'icon', name: 'arrow-right', size: 18 %}</button>
          </div>
        </div>
        <ul class="rail__track spot__track" role="list" data-rail-track>
          {%- if c != blank and c.products_count > 0 -%}
            {%- for product in c.products limit: s.limit -%}
              <li>{%- render 'product-card', product: product, style: s.card_style, ratio: s.image_ratio, section_id: section.id, sizes: '(min-width: 990px) 22vw, 70vw' -%}</li>
            {%- endfor -%}
          {%- else -%}
            {%- for i in (1..4) -%}<li>{%- render 'product-card', product: blank, style: s.card_style, ratio: s.image_ratio -%}</li>{%- endfor -%}
          {%- endif -%}
        </ul>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.collection-spotlight.name",
  "class": "section-collection-spotlight",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "t:sections.collection-spotlight.settings.collection.label"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.collection-spotlight.settings.image.label",
      "info": "t:sections.collection-spotlight.settings.image.info"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "t:sections.collection-spotlight.settings.kicker.label",
      "default": "In the spotlight"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.collection-spotlight.settings.heading.label",
      "info": "t:sections.collection-spotlight.settings.heading.info",
      "default": "The pearl edit"
    },
    {
      "type": "text",
      "id": "text",
      "label": "t:sections.collection-spotlight.settings.text.label",
      "default": "Lustrous freshwater pearls, set in warm gold."
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "t:sections.collection-spotlight.settings.link_label.label",
      "default": "Shop the edit →"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:sections.collection-spotlight.settings.link.label",
      "info": "t:sections.collection-spotlight.settings.link.info"
    },
    {
      "type": "text",
      "id": "rail_heading",
      "label": "t:sections.collection-spotlight.settings.rail_heading.label",
      "default": "Pieces in this edit"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "t:sections.collection-spotlight.settings.limit.label",
      "min": 3,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "select",
      "id": "panel_side",
      "label": "t:sections.collection-spotlight.settings.panel_side.label",
      "options": [
        {
          "value": "left",
          "label": "t:sections.collection-spotlight.settings.panel_side.options__1.label"
        },
        {
          "value": "right",
          "label": "t:sections.collection-spotlight.settings.panel_side.options__2.label"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "card_style",
      "label": "t:sections.collection-spotlight.settings.card_style.label",
      "options": [
        {
          "value": "boxed",
          "label": "t:sections.collection-spotlight.settings.card_style.options__1.label"
        },
        {
          "value": "bordered",
          "label": "t:sections.collection-spotlight.settings.card_style.options__2.label"
        },
        {
          "value": "plain",
          "label": "t:sections.collection-spotlight.settings.card_style.options__3.label"
        }
      ],
      "default": "boxed"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:sections.collection-spotlight.settings.image_ratio.label",
      "options": [
        {
          "value": "adapt",
          "label": "t:sections.collection-spotlight.settings.image_ratio.options__1.label"
        },
        {
          "value": "square",
          "label": "t:sections.collection-spotlight.settings.image_ratio.options__2.label"
        },
        {
          "value": "jewel",
          "label": "t:sections.collection-spotlight.settings.image_ratio.options__3.label"
        },
        {
          "value": "portrait",
          "label": "t:sections.collection-spotlight.settings.image_ratio.options__4.label"
        }
      ],
      "default": "adapt"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.collection-spotlight.settings.color_scheme.label",
      "default": "scheme-3"
    }
  ],
  "presets": [
    {
      "name": "t:sections.collection-spotlight.presets.presets__1.name"
    }
  ]
}
{% endschema %}
