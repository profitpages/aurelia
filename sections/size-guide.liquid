            "value_3": "54.4 mm",
            "value_4": "O"
          }
        },
        {
          "type": "row",
          "settings": {
            "size": "8",
            "value_2": "18.2 mm",
            "value_3": "57.0 mm",
            "value_4": "Q"
          }
        },
        {
          "type": "row",
          "settings": {
            "size": "9",
            "value_2": "19.0 mm",
            "value_3": "59.5 mm",
            "value_4": "S"
          }
        }
      ]
    }
  ]
}
{% endschema %}
