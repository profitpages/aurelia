{%- comment -%} Size guide — a hairline size table (one block per row) beside numbered measuring tips. Ideal on a "Size guide" page. {%- endcomment -%}
{{ 'section-aurelia-extras.css' | asset_url | stylesheet_tag }}
{%- assign s = section.settings -%}
<section class="section color-{{ s.color_scheme }}">
  <div class="page-width">
    {%- render 'section-heading', kicker: s.kicker, title: s.heading, text: s.text, align: 'center' -%}
    <div class="sizes">
      <div class="sizes__table-wrap table-wrap">
        <table class="sizes__table">
          <caption class="visually-hidden">{{ s.heading | escape }}</caption>
          <thead>
            <tr><th scope="col">{{ s.col_1 | escape }}</th><th scope="col">{{ s.col_2 | escape }}</th><th scope="col">{{ s.col_3 | escape }}</th>{%- if s.col_4 != blank -%}<th scope="col">{{ s.col_4 | escape }}</th>{%- endif -%}</tr>
          </thead>
          <tbody>
            {%- for block in section.blocks -%}
              {%- assign b = block.settings -%}
              <tr {{ block.shopify_attributes }}>
                <th scope="row">{{ b.size | escape }}</th><td>{{ b.value_2 | escape }}</td><td>{{ b.value_3 | escape }}</td>{%- if s.col_4 != blank -%}<td>{{ b.value_4 | escape }}</td>{%- endif -%}
              </tr>
            {%- endfor -%}
          </tbody>
        </table>
      </div>
      <aside class="sizes__tips">
        {%- if s.tips_heading != blank -%}<h3 class="sizes__tips-title">{{ s.tips_heading | escape }}</h3>{%- endif -%}
        {%- if s.tips != blank -%}<div class="rte sizes__tips-body">{{ s.tips }}</div>{%- endif -%}
        {%- if s.link_label != blank and s.link != blank -%}<a class="link-underline" href="{{ s.link }}">{{ s.link_label | escape }}</a>{%- endif -%}
      </aside>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.size-guide.name",
  "class": "section-size-guide",
  "max_blocks": 20,
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "t:sections.size-guide.settings.kicker.label",
      "default": "Find your fit"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.size-guide.settings.heading.label",
      "default": "Ring size guide"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.size-guide.settings.text.label",
      "default": "<p>Between sizes? We recommend choosing the larger size.</p>"
    },
    {
      "type": "text",
      "id": "col_1",
      "label": "t:sections.size-guide.settings.col_1.label",
      "default": "US size"
    },
    {
      "type": "text",
      "id": "col_2",
      "label": "t:sections.size-guide.settings.col_2.label",
      "default": "Inside diameter"
    },
    {
      "type": "text",
      "id": "col_3",
      "label": "t:sections.size-guide.settings.col_3.label",
      "default": "Circumference"
    },
    {
      "type": "text",
      "id": "col_4",
      "label": "t:sections.size-guide.settings.col_4.label",
      "default": "UK size"
    },
    {
      "type": "text",
      "id": "tips_heading",
      "label": "t:sections.size-guide.settings.tips_heading.label",
      "default": "How to measure"
    },
    {
      "type": "richtext",
      "id": "tips",
      "label": "t:sections.size-guide.settings.tips.label",
      "default": "<ol><li>Choose a ring that fits the finger you want to wear it on.</li><li>Measure the inside diameter edge to edge, in millimetres.</li><li>Match your measurement to the closest size in the table.</li></ol>"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "t:sections.size-guide.settings.link_label.label",
      "default": "Download a printable sizer"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:sections.size-guide.settings.link.label",
      "info": "t:sections.size-guide.settings.link.info"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.size-guide.settings.color_scheme.label",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "t:sections.size-guide.blocks.row.name",
      "settings": [
        {
          "type": "text",
          "id": "size",
          "label": "t:sections.size-guide.blocks.row.settings.size.label",
          "default": "5"
        },
        {
          "type": "text",
          "id": "value_2",
          "label": "t:sections.size-guide.blocks.row.settings.value_2.label",
          "default": "15.7 mm"
        },
        {
          "type": "text",
          "id": "value_3",
          "label": "t:sections.size-guide.blocks.row.settings.value_3.label",
          "default": "49.3 mm"
        },
        {
          "type": "text",
          "id": "value_4",
          "label": "t:sections.size-guide.blocks.row.settings.value_4.label",
          "default": "J ½"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.size-guide.presets.presets__1.name",
      "blocks": [
        {
          "type": "row"
        },
        {
