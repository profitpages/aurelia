{%- comment -%}
  Engraving preview — shoppers type a few characters and see them engraved inside a gold band.
  Purely a preview: the order engraving is collected by the product page's Engraving block.
{%- endcomment -%}
{{ 'section-aurelia-extras.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  assign uid = 'Engrave-' | append: section.id
-%}
{%- if s.load_script_font -%}
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Pinyon+Script&display=swap" rel="stylesheet">
{%- endif -%}
<section class="section color-{{ s.color_scheme }}">
  <div class="page-width">
    <engraving-preview class="engp" data-max="{{ s.max_chars }}">
      <div class="engp__stage" aria-hidden="true">
        <svg class="engp__ring" viewBox="0 0 400 300" focusable="false">
          <defs>
            <linearGradient id="{{ uid }}-gold" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="#f3dfaa"/><stop offset=".45" stop-color="#c9a15a"/><stop offset="1" stop-color="#8c6a33"/>
            </linearGradient>
            <path id="{{ uid }}-arc" d="M80 170 A120 70 0 0 0 320 170"/>
          </defs>
          <ellipse cx="200" cy="150" rx="150" ry="95" fill="url(#{{ uid }}-gold)"/>
          <ellipse cx="200" cy="150" rx="128" ry="76" fill="var(--bg)"/>
          <ellipse cx="200" cy="150" rx="128" ry="76" fill="none" stroke="#8c6a33" stroke-opacity=".35"/>
          <text class="engp__text engp__text--{{ s.default_style }}" fill="#6b5127" text-anchor="middle" data-engp-text>
            <textPath href="#{{ uid }}-arc" startOffset="50%">{{ s.sample | escape }}</textPath>
          </text>
        </svg>
      </div>
      <div class="engp__copy">
        {%- if s.kicker != blank -%}<p class="kicker">{{ s.kicker | escape }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="h2">{{ s.heading | escape }}</h2>{%- endif -%}
        {%- if s.text != blank -%}<div class="rte engp__lead">{{ s.text }}</div>{%- endif -%}
        <label class="label" for="{{ uid }}-input">{{ s.input_label | escape }}</label>
        <input class="input" id="{{ uid }}-input" type="text" maxlength="{{ s.max_chars }}" value="{{ s.sample | escape }}" autocomplete="off" data-engp-input>
        <div class="engp__meta"><span>{{ s.note | escape }}</span><span data-engp-count aria-live="polite"></span></div>
        <div class="engp__styles" role="radiogroup" aria-label="{{ s.style_label | escape }}">
          {%- assign styles = 'serif,script,caps' | split: ',' -%}
          {%- for st in styles -%}
            {%- assign st_key = 'sections.engraving_' | append: st -%}
            <button class="engp__style engp__style--{{ st }}" type="button" role="radio" data-engp-style="{{ st }}" aria-checked="{% if st == s.default_style %}true{% else %}false{% endif %}">{{ st_key | t }}</button>
          {%- endfor -%}
        </div>
        {%- if s.button_label != blank -%}
          {%- assign btn_url = s.product.url | default: s.link | default: routes.all_products_collection_url -%}
          {%- render 'button', label: s.button_label, url: btn_url, style: 'solid' -%}
        {%- endif -%}
      </div>
    </engraving-preview>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.engraving-preview.name",
  "class": "section-engraving-preview",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "t:sections.engraving-preview.settings.kicker.label",
      "default": "Make it yours"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.engraving-preview.settings.heading.label",
      "default": "Complimentary engraving"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.engraving-preview.settings.text.label",
      "default": "<p>Initials, a date, a word that matters. Preview your engraving, then add it on any ring or pendant page.</p>"
    },
    {
      "type": "text",
      "id": "input_label",
      "label": "t:sections.engraving-preview.settings.input_label.label",
      "default": "Your engraving"
    },
    {
      "type": "text",
      "id": "sample",
      "label": "t:sections.engraving-preview.settings.sample.label",
      "default": "A & J · 06.21"
    },
    {
      "type": "range",
      "id": "max_chars",
      "label": "t:sections.engraving-preview.settings.max_chars.label",
      "min": 6,
      "max": 30,
      "step": 1,
      "default": 18
    },
    {
      "type": "text",
      "id": "note",
      "label": "t:sections.engraving-preview.settings.note.label",
      "default": "Personalized items are final sale."
    },
    {
      "type": "text",
      "id": "style_label",
      "label": "t:sections.engraving-preview.settings.style_label.label",
      "default": "Engraving style"
    },
    {
      "type": "select",
      "id": "default_style",
      "label": "t:sections.engraving-preview.settings.default_style.label",
      "options": [
        {
          "value": "serif",
          "label": "t:sections.engraving-preview.settings.default_style.options__1.label"
        },
        {
          "value": "script",
          "label": "t:sections.engraving-preview.settings.default_style.options__2.label"
        },
        {
          "value": "caps",
          "label": "t:sections.engraving-preview.settings.default_style.options__3.label"
        }
      ],
      "default": "serif"
    },
    {
      "type": "checkbox",
      "id": "load_script_font",
      "label": "t:sections.engraving-preview.settings.load_script_font.label",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.engraving-preview.settings.button_label.label",
      "default": "Shop engravable pieces"
    },
    {
      "type": "product",
      "id": "product",
      "label": "t:sections.engraving-preview.settings.product.label"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:sections.engraving-preview.settings.link.label",
      "info": "t:sections.engraving-preview.settings.link.info"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.engraving-preview.settings.color_scheme.label",
      "default": "scheme-3"
    }
  ],
  "presets": [
    {
      "name": "t:sections.engraving-preview.presets.presets__1.name"
    }
  ]
}
{% endschema %}
