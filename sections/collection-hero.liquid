{%- comment -%}
  Collection banner — Aurelia split: collection photo beside a tinted panel with the collection title,
  description, an optional support line and a link down to the products. Falls back to section settings
  outside collection pages (e.g. search).
{%- endcomment -%}
{{ 'section-collection.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  assign title = s.heading
  assign desc = s.text
  assign img = s.image
  if collection
    assign title = collection.title
    if collection.description != blank
      assign desc = collection.description
    endif
    if img == blank
      assign img = collection.image | default: collection.products.first.featured_media.preview_image
    endif
  elsif request.page_type == 'search'
    assign title = 'search.title' | t
  endif
-%}
<section class="coll-hero-wrap color-{{ s.section_scheme }}">
  <div class="page-width page-width--wide">
    {%- if s.show_breadcrumb -%}{%- render 'breadcrumb' -%}{%- endif -%}
    <div class="coll-hero{% unless s.show_image %} coll-hero--text{% endunless %} color-{{ s.color_scheme }}">
      {%- if s.show_image -%}
        <div class="coll-hero__media">
          {%- render 'responsive-image', image: img, max: 1800, sizes: '(min-width: 990px) 55vw, 100vw', class: 'coll-hero__img', eager: true, art: 'necklace', alt: '' -%}
        </div>
      {%- endif -%}
      <div class="coll-hero__copy">
        {%- if s.kicker != blank -%}<p class="kicker coll-hero__kicker">{{ s.kicker | escape }}</p>{%- endif -%}
        <h1 class="coll-hero__title">{{ title | escape }}</h1>
        {%- if desc != blank -%}<div class="rte coll-hero__text">{{ desc }}</div>{%- endif -%}
        {%- if s.support != blank -%}<p class="coll-hero__support">{{ s.support | escape }}</p>{%- endif -%}
        {%- if s.show_count and collection -%}<p class="coll-hero__support">{{ 'collections.pieces' | t: count: collection.products_count }}</p>{%- endif -%}
        {%- if s.link_label != blank -%}<a class="link-underline coll-hero__cta" href="{{ s.link | default: '#ProductGrid' }}">{{ s.link_label | escape }}</a>{%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection banner",
  "class": "section-collection-hero",
  "settings": [
    { "type": "checkbox", "id": "show_breadcrumb", "label": "Show breadcrumb", "default": true },
    { "type": "checkbox", "id": "show_image", "label": "Show image", "default": true },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Defaults to the collection image, then the first product's image." },
    { "type": "text", "id": "kicker", "label": "Eyebrow", "default": "Aurelia collections" },
    { "type": "text", "id": "heading", "label": "Heading (when not on a collection)", "default": "The signature collection" },
    { "type": "richtext", "id": "text", "label": "Text (when the collection has no description)", "default": "<p>Iconic pieces designed to become timeless essentials.</p>" },
    { "type": "text", "id": "support", "label": "Support line", "default": "Discover luminous silhouettes made for the moments you keep." },
    { "type": "checkbox", "id": "show_count", "label": "Show product count", "default": false },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Shop the collection" },
    { "type": "url", "id": "link", "label": "Link", "info": "Defaults to the product grid on this page." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Panel color scheme", "default": "scheme-4" },
    { "type": "color_scheme", "id": "section_scheme", "label": "Section background", "default": "scheme-1" }
  ],
  "presets": [{ "name": "Collection banner" }]
}
{% endschema %}
