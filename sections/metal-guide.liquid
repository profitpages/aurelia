{%- comment -%} Metal guide — finish swatches with a short description and key facts, each linking to a collection. {%- endcomment -%}
{{ 'section-aurelia-extras.css' | asset_url | stylesheet_tag }}
{%- assign s = section.settings -%}
<section class="section color-{{ s.color_scheme }}">
  <div class="page-width">
    {%- render 'section-heading', kicker: s.kicker, title: s.heading, text: s.text, align: 'center' -%}
    <ul class="metals" role="list" style="--cols: {{ section.blocks.size | at_least: 1 | at_most: 4 }};">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        {%- assign url = b.link | default: b.collection.url -%}
        <li class="metal" data-reveal {{ block.shopify_attributes }}>
          <span class="metal__swatch" style="--metal: {{ b.color }};" aria-hidden="true">
            {%- if b.image != blank -%}{{ b.image | image_url: width: 240 | image_tag: loading: 'lazy', alt: '', width: 96, height: 96 }}{%- endif -%}
          </span>
          <h3 class="metal__title">{{ b.title | escape }}</h3>
          {%- if b.text != blank -%}<p class="metal__text">{{ b.text | escape }}</p>{%- endif -%}
          {%- assign facts = b.facts | newline_to_br | split: '<br />' -%}
          {%- if b.facts != blank -%}
            <ul class="metal__facts" role="list">
              {%- for f in facts -%}{%- assign ft = f | strip -%}{%- if ft != blank -%}<li>{{ ft | escape }}</li>{%- endif -%}{%- endfor -%}
            </ul>
          {%- endif -%}
          {%- if url != blank and b.link_label != blank -%}<a class="link-underline metal__go" href="{{ url }}">{{ b.link_label | escape }}</a>{%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.metal-guide.name",
  "class": "section-metal-guide",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "t:sections.metal-guide.settings.kicker.label",
      "default": "Know your metals"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.metal-guide.settings.heading.label",
      "default": "Find your finish"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.metal-guide.settings.text.label",
      "default": "<p>Every finish is made to be worn daily. Here is how they compare.</p>"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.metal-guide.settings.color_scheme.label",
      "default": "scheme-2"
    }
  ],
  "blocks": [
    {
      "type": "metal",
      "name": "t:sections.metal-guide.blocks.metal.name",
      "settings": [
        {
          "type": "color",
          "id": "color",
          "label": "t:sections.metal-guide.blocks.metal.settings.color.label",
          "default": "#d4af6a"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.metal-guide.blocks.metal.settings.image.label",
          "info": "t:sections.metal-guide.blocks.metal.settings.image.info"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.metal-guide.blocks.metal.settings.title.label",
          "default": "18k Yellow Gold"
        },
        {
          "type": "text",
          "id": "text",
          "label": "t:sections.metal-guide.blocks.metal.settings.text.label",
          "default": "Warm and timeless, the classic Aurelia finish."
        },
        {
          "type": "textarea",
          "id": "facts",
          "label": "t:sections.metal-guide.blocks.metal.settings.facts.label",
          "default": "Gold vermeil over sterling silver\nTarnish resistant\nHypoallergenic"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "t:sections.metal-guide.blocks.metal.settings.link_label.label",
          "default": "Shop yellow gold"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "t:sections.metal-guide.blocks.metal.settings.collection.label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.metal-guide.blocks.metal.settings.link.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.metal-guide.presets.presets__1.name",
      "blocks": [
        {
          "type": "metal"
        },
        {
          "type": "metal",
          "settings": {
            "color": "#d8a48f",
            "title": "Rose Gold",
            "text": "A soft blush tone that flatters every skin tone.",
            "facts": "Rose gold vermeil\nTarnish resistant\nHypoallergenic",
            "link_label": "Shop rose gold"
          }
        },
        {
          "type": "metal",
          "settings": {
            "color": "#c9c9c6",
            "title": "Sterling Silver",
            "text": "Cool, bright and endlessly versatile.",
            "facts": "Solid 925 silver\nRhodium finish\nNickel-free",
            "link_label": "Shop silver"
          }
        }
      ]
    }
  ]
}
{% endschema %}
