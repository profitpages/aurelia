{{ 'section-aurelia.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  assign scheme = settings.color_schemes[s.color_scheme]
  assign is_dark = false
  if scheme.settings.background.lightness < 45
    assign is_dark = true
  endif
  assign socials = 'instagram,pinterest,facebook,tiktok,x,youtube' | split: ','
  assign show_country = false
  if s.show_country and localization.available_countries.size > 1
    assign show_country = true
  endif
  assign show_language = false
  if s.show_language and localization.available_languages.size > 1
    assign show_language = true
  endif
  assign menu_cols = 0
  for block in section.blocks
    assign menu_cols = menu_cols | plus: 1
  endfor
-%}
<footer class="footer color-{{ s.color_scheme }}">
  <div class="page-width">
    <div class="footer__grid" style="--cols: {{ menu_cols | at_least: 1 | at_most: 4 }};">
      <div class="footer__brand">
        {%- render 'wordmark', inverse: is_dark -%}
        {%- if s.blurb != blank -%}<div class="footer__blurb rte">{{ s.blurb }}</div>{%- endif -%}
        {%- if s.show_social -%}
          <ul class="socials" role="list">
            {%- for name in socials -%}
              {%- assign key = 'social_' | append: name -%}
              {%- assign social_key = 'general.social_' | append: name -%}
              {%- assign social_label = social_key | t -%}
              {%- if settings[key] != blank -%}
                <li><a href="{{ settings[key] }}" target="_blank" rel="noopener" aria-label="{{ social_label }}">{% render 'icon', name: name, size: 20 %}</a></li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      {%- for block in section.blocks -%}
        <div class="footer__col footer__col--{{ block.type }}" {{ block.shopify_attributes }}>
          {%- case block.type -%}
            {%- when 'menu' -%}
              {%- if block.settings.heading != blank -%}<h2 class="footer__title">{{ block.settings.heading | escape }}</h2>{%- endif -%}
              <ul class="footer__links" role="list">
                {%- for link in block.settings.menu.links -%}
                  <li><a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a></li>
                {%- endfor -%}
              </ul>
            {%- when 'text' -%}
              {%- if block.settings.heading != blank -%}<h2 class="footer__title">{{ block.settings.heading | escape }}</h2>{%- endif -%}
              <div class="rte footer__text">{{ block.settings.text }}</div>
            {%- when 'newsletter' -%}
              {%- if block.settings.heading != blank -%}<h2 class="footer__title">{{ block.settings.heading | escape }}</h2>{%- endif -%}
              {%- if block.settings.text != blank -%}<p class="footer__text">{{ block.settings.text | escape }}</p>{%- endif -%}
              {%- assign f_nl_id = 'FooterNewsletter-' | append: block.id -%}
              {%- form 'customer', id: f_nl_id, class: 'nl-form nl-form--compact footer__nl' -%}
                <input type="hidden" name="contact[tags]" value="newsletter">
                {%- if form.posted_successfully? -%}
                  <p class="form-msg form-msg--ok" role="status">{{ 'newsletter.success' | t }}</p>
                {%- else -%}
                  <div class="nl-form__field">
                    <label class="visually-hidden" for="{{ f_nl_id }}-email">{{ 'newsletter.email_label' | t }}</label>
                    <input class="input" id="{{ f_nl_id }}-email" type="email" name="contact[email]" autocomplete="email" required placeholder="{{ 'newsletter.email_label' | t }}">
                    <button class="btn btn--accent" type="submit" aria-label="{{ 'newsletter.subscribe' | t }}">{% render 'icon', name: 'arrow-right', size: 18 %}</button>
                  </div>
                  {%- if form.errors -%}<p class="form-msg form-msg--error">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>{%- endif -%}
                {%- endif -%}
              {%- endform -%}
          {%- endcase -%}
        </div>
      {%- endfor -%}
    </div>

    <div class="footer__bottom">
      <div class="footer__legal-row">
        {%- if s.show_policies -%}
          <ul class="footer__policies" role="list">
            {%- for policy in shop.policies -%}<li><a href="{{ policy.url }}">{{ policy.title | escape }}</a></li>{%- endfor -%}
          </ul>
        {%- endif -%}
        <p class="footer__legal">&copy; {{ 'now' | date: '%Y' }} {{ shop.name | link_to: routes.root_url }}{%- if s.copyright != blank %} · {{ s.copyright | escape }}{% endif -%}</p>
      </div>
      <div class="footer__utility">
        {%- if show_country or show_language -%}
          {%- form 'localization', id: 'FooterLocalization', class: 'footer__locale' -%}
            {%- if show_country -%}
              <label class="visually-hidden" for="FooterCountry">{{ 'general.country' | t }}</label>
              <select class="select select--sm footer__select" id="FooterCountry" name="country_code" data-localization-select>
                {%- for country in localization.available_countries -%}
                  <option value="{{ country.iso_code }}"{% if country.iso_code == localization.country.iso_code %} selected{% endif %}>{{ country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})</option>
                {%- endfor -%}
              </select>
            {%- endif -%}
            {%- if show_language -%}
              <label class="visually-hidden" for="FooterLanguage">{{ 'general.language' | t }}</label>
              <select class="select select--sm footer__select" id="FooterLanguage" name="language_code" data-localization-select>
                {%- for language in localization.available_languages -%}
                  <option value="{{ language.iso_code }}" lang="{{ language.iso_code }}"{% if language.iso_code == localization.language.iso_code %} selected{% endif %}>{{ language.endonym_name | capitalize }}</option>
                {%- endfor -%}
              </select>
            {%- endif -%}
            <noscript><button class="btn btn--sm btn--outline" type="submit">{{ 'general.update' | t }}</button></noscript>
          {%- endform -%}
        {%- endif -%}
        {%- if s.show_payment and shop.enabled_payment_types.size > 0 -%}
          <ul class="footer__pay" role="list">
            {%- for type in shop.enabled_payment_types -%}<li>{{ type | payment_type_svg_tag: class: 'pay-icon' }}</li>{%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "t:sections.footer.name",
  "class": "section-footer",
  "max_blocks": 4,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.footer.settings.color_scheme.label",
      "default": "scheme-6"
    },
    {
      "type": "richtext",
      "id": "blurb",
      "label": "t:sections.footer.settings.blurb.label",
      "default": "<p>Modern heirlooms for every chapter of your story.</p>"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "t:sections.footer.settings.show_social.label",
      "default": true,
      "info": "t:sections.footer.settings.show_social.info"
    },
    {
      "type": "header",
      "content": "t:sections.footer.settings.header__4.content"
    },
    {
      "type": "checkbox",
      "id": "show_country",
      "label": "t:sections.footer.settings.show_country.label",
      "default": true,
      "info": "t:sections.footer.settings.show_country.info"
    },
    {
      "type": "checkbox",
      "id": "show_language",
      "label": "t:sections.footer.settings.show_language.label",
      "default": true,
      "info": "t:sections.footer.settings.show_language.info"
    },
    {
      "type": "checkbox",
      "id": "show_policies",
      "label": "t:sections.footer.settings.show_policies.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_payment",
      "label": "t:sections.footer.settings.show_payment.label",
      "default": true
    },
    {
      "type": "text",
      "id": "copyright",
      "label": "t:sections.footer.settings.copyright.label"
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "t:sections.footer.blocks.menu.name",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.footer.blocks.menu.settings.heading.label",
          "default": "Shop"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "t:sections.footer.blocks.menu.settings.menu.label",
          "default": "footer"
        }
      ]
    },
    {
      "type": "text",
      "name": "t:sections.footer.blocks.text.name",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.footer.blocks.text.settings.heading.label",
          "default": "Customer care"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:sections.footer.blocks.text.settings.text.label",
          "default": "<p>hello@yourstore.com<br>Mon–Fri, 9am–6pm</p>"
        }
      ]
    },
    {
      "type": "newsletter",
      "name": "t:sections.footer.blocks.newsletter.name",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.footer.blocks.newsletter.settings.heading.label",
          "default": "The Aurelia letter"
        },
        {
          "type": "text",
          "id": "text",
          "label": "t:sections.footer.blocks.newsletter.settings.text.label",
          "default": "New collections and styling notes, a few times a month."
        }
      ]
    }
  ]
}
{% endschema %}
