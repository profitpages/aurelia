{%- comment -%}
  Reviews — integration point for review apps. Never invents reviews:
  • App block(s) render the real review widget (breakdown + review cards).
  • Rating summary reads the standard reviews.rating / reviews.rating_count metafields.
  • With no app and no data, nothing shows to shoppers; merchants see a setup hint in the editor.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign has_app = false
  for block in section.blocks
    if block.type == '@app'
      assign has_app = true
    endif
  endfor
  assign r = product.metafields.reviews.rating.value
  assign count = product.metafields.reviews.rating_count.value | default: 0
  assign addons = shop.metafields.profitpages.addons.value
  assign pp = product.metafields.profitpages.reviews.value
  assign has_pp = false
  if addons.active and pp.items.size > 0
    assign has_pp = true
  endif
-%}
{%- if has_app or has_pp or r != blank or request.design_mode -%}
  {{ 'section-aurelia.css' | asset_url | stylesheet_tag }}
  <section class="section color-{{ s.color_scheme }} reviews-band" id="reviews">
    <div class="page-width reviews-band__wrap">
      <header class="reviews__head">
        <div class="sec-head__main">
          {%- if s.kicker != blank -%}<p class="kicker">{{ s.kicker | escape }}</p>{%- endif -%}
          {%- if s.heading != blank -%}<h2 class="h2">{{ s.heading | escape }}</h2>{%- endif -%}
        </div>
        {%- if s.write_label != blank and s.write_link != blank -%}
          <a class="btn btn--outline btn--sm" href="{{ s.write_link }}">{{ s.write_label | escape }}</a>
        {%- endif -%}
      </header>
      <div class="reviews__grid{% if r == blank %} reviews__grid--app{% endif %}">
        {%- if r != blank -%}
          {%- assign avg = r.rating | round: 1 -%}
          {%- assign max = r.scale_max | default: 5 -%}
          {%- assign pct = r.rating | divided_by: max | times: 100 -%}
          <div class="reviews__summary">
            <p class="reviews__score">{{ 'products.score_out_of' | t: rating: avg, max: max }}</p>
            <span class="rating__stars rating__stars--lg" style="--pct: {{ pct }}%;" aria-hidden="true">★★★★★</span>
            <p class="reviews__score-line">{{ 'products.reviews_count' | t: count: count }}</p>
          </div>
        {%- endif -%}
        <div class="reviews__app">
          {%- if has_pp -%}
            <div class="pp-reviews" data-pp-reviews data-product-id="{{ product.id }}">
              <div class="pp-reviews__list" data-pp-reviews-list>
                {%- for item in pp.items -%}{%- render 'pp-review-card', review: item -%}{%- endfor -%}
              </div>
              <template data-pp-review-template>{%- render 'pp-review-card', review: blank -%}</template>
              {%- if pp.count > pp.items.size -%}
                <button type="button" class="btn btn--outline btn--sm pp-reviews__more" data-pp-reviews-more>{{ 'addons.reviews_more' | t }}</button>
              {%- endif -%}
              {%- if pp.disclosure != blank -%}<p class="pp-reviews__note">{{ pp.disclosure | escape }}</p>{%- endif -%}
            </div>
          {%- endif -%}
          {%- for block in section.blocks -%}
            {%- if block.type == '@app' -%}{% render block %}{%- endif -%}
          {%- endfor -%}
          {%- if has_app == false and has_pp == false and request.design_mode -%}
            <div class="reviews__hint">
              {%- render 'icon', name: 'star', size: 20 -%}
              <p><strong>{{ 'sections.reviews_hint_title' | t }}</strong><br>{{ 'sections.reviews_hint' | t }}</p>
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.reviews.name",
  "class": "section-reviews",
  "enabled_on": {
    "templates": [
      "product"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "t:sections.reviews.settings.kicker.label",
      "default": "The Aurelia community"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.reviews.settings.heading.label",
      "default": "Customer reviews"
    },
    {
      "type": "text",
      "id": "write_label",
      "label": "t:sections.reviews.settings.write_label.label",
      "default": "Write a review"
    },
    {
      "type": "url",
      "id": "write_link",
      "label": "t:sections.reviews.settings.write_link.label",
      "info": "t:sections.reviews.settings.write_link.info"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.reviews.settings.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "paragraph",
      "content": "t:sections.reviews.settings.paragraph__6.content"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "t:sections.reviews.presets.presets__1.name"
    }
  ]
}
{% endschema %}
