{%- assign s = section.settings -%}
{{ 'section-content.css' | asset_url | stylesheet_tag }}
<section class="section color-{{ s.color_scheme }}">
  <div class="page-width{% if s.layout == 'stacked' %} page-width--faq{% endif %}">
    <div class="faq faq--{{ s.layout }}">
      {%- render 'section-heading', kicker: s.kicker, title: s.heading, text: s.text, align: s.align -%}
      <div class="accordion-list{% if s.style == 'faq' %} accordion-list--bare{% endif %}">
        {%- for block in section.blocks -%}
          <details class="acc{% if s.style == 'faq' %} acc--faq{% endif %}" data-accordion{% if block.settings.open %} open{% endif %} {{ block.shopify_attributes }}>
            <summary class="acc__q">{{ block.settings.question | escape }}<span class="acc__plus" aria-hidden="true"></span></summary>
            <div class="acc__a"><div class="acc__inner rte">{{ block.settings.answer }}</div></div>
          </details>
        {%- endfor -%}
      </div>
    </div>
  </div>
  {%- if s.schema_markup and section.blocks.size > 0 -%}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
          {%- assign sep = '' -%}
          {%- for block in section.blocks -%}
            {%- if block.settings.answer != blank -%}
              {{ sep }}{ "@type": "Question", "name": {{ block.settings.question | json }}, "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} } }
              {%- assign sep = ',' -%}
            {%- endif -%}
          {%- endfor -%}
        ]
      }
    </script>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "t:sections.faq.name",
  "class": "section-faq",
  "max_blocks": 16,
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "t:sections.faq.settings.kicker.label",
      "default": "A few helpful notes"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.faq.settings.heading.label",
      "default": "Frequently asked."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.faq.settings.text.label"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.faq.settings.layout.label",
      "options": [
        {
          "value": "stacked",
          "label": "t:sections.faq.settings.layout.options__1.label"
        },
        {
          "value": "side",
          "label": "t:sections.faq.settings.layout.options__2.label"
        }
      ],
      "default": "stacked"
    },
    {
      "type": "select",
      "id": "style",
      "label": "t:sections.faq.settings.style.label",
      "options": [
        {
          "value": "faq",
          "label": "t:sections.faq.settings.style.options__1.label"
        },
        {
          "value": "plus",
          "label": "t:sections.faq.settings.style.options__2.label"
        }
      ],
      "default": "faq"
    },
    {
      "type": "select",
      "id": "align",
      "label": "t:sections.faq.settings.align.label",
      "options": [
        {
          "value": "left",
          "label": "t:sections.faq.settings.align.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.faq.settings.align.options__2.label"
        }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "schema_markup",
      "label": "t:sections.faq.settings.schema_markup.label",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.faq.settings.color_scheme.label",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "t:sections.faq.blocks.question.name",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "t:sections.faq.blocks.question.settings.question.label",
          "default": "How long does shipping take?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "t:sections.faq.blocks.question.settings.answer.label",
          "default": "<p>Orders are prepared within 24 hours on business days and usually arrive in 2–5 days.</p>"
        },
        {
          "type": "checkbox",
          "id": "open",
          "label": "t:sections.faq.blocks.question.settings.open.label",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.faq.presets.presets__1.name",
      "blocks": [
        {
          "type": "question",
          "settings": {
            "question": "When will my order ship?",
            "answer": "<p>Orders are prepared within one business day and usually arrive in 2–5 days.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "What is your returns approach?",
            "answer": "<p>Unworn pieces can be returned within 30 days for a full refund. Engraved pieces are final sale.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "How do I care for my jewellery?",
            "answer": "<p>Store pieces separately in their pouch, keep them away from perfume and water, and polish gently with a soft cloth.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Is your jewellery suitable for sensitive skin?",
            "answer": "<p>Most pieces are nickel-free and hypoallergenic. Each product page lists its materials.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Where are your pieces made?",
            "answer": "<p>Add details about your materials, sourcing and certifications here.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "How can I get order support?",
            "answer": "<p>Write to us any time — we reply within one business day.</p>"
          }
        }
      ]
    },
    {
      "name": "t:sections.faq.presets.presets__2.name",
      "settings": {
        "layout": "side",
        "style": "plus",
        "kicker": "Good to know",
        "heading": "Every last detail.",
        "schema_markup": false
      },
      "blocks": [
        {
          "type": "question",
          "settings": {
            "question": "Materials",
            "answer": "<p>Connect this to the product's material metafield with the dynamic-source button.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Size & fit",
            "answer": "<p>Share dimensions, weight and how the piece sits when worn.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Packaging",
            "answer": "<p>Share packaging and gift-wrap details.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
